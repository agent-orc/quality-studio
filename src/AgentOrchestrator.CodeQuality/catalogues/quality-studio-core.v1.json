{
  "$schema": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "schemaVersion": 1,
  "id": "quality-studio/core",
  "version": "1.0.0",
  "terms": [
    { "id": "agent", "axis": "producer-kind", "description": "A model-backed review agent produced the fact.", "order": 0, "aliases": [], "deprecated": false },
    { "id": "deterministic-sensor", "axis": "producer-kind", "description": "A deterministic tool or sensor produced the fact.", "order": 1, "aliases": ["deterministic"], "deprecated": false },
    { "id": "human", "axis": "producer-kind", "description": "A human produced the fact.", "order": 2, "aliases": [], "deprecated": false },
    { "id": "imported", "axis": "producer-kind", "description": "A migration adapter produced the record from a legacy fact.", "order": 3, "aliases": [], "deprecated": false },
    { "id": "unknown", "axis": "producer-kind", "description": "The producer kind cannot be established from preserved evidence.", "order": 4, "aliases": [], "deprecated": false },

    { "id": "available", "axis": "evidence-status", "description": "The expected evidence was available to the producer.", "order": 0, "aliases": [], "deprecated": false },
    { "id": "partial", "axis": "evidence-status", "description": "Some expected evidence was unavailable or incomplete.", "order": 1, "aliases": [], "deprecated": false },
    { "id": "unavailable", "axis": "evidence-status", "description": "The expected evidence could not be obtained.", "order": 2, "aliases": [], "deprecated": false },

    { "id": "pass", "axis": "assessment", "description": "The evidence establishes conformance for the assessed scope.", "order": 0, "aliases": [], "deprecated": false },
    { "id": "concern", "axis": "assessment", "description": "The evidence establishes a concern without establishing failure.", "order": 1, "aliases": [], "deprecated": false },
    { "id": "fail", "axis": "assessment", "description": "The evidence establishes non-conformance for the assessed scope.", "order": 2, "aliases": ["finding"], "deprecated": false },
    { "id": "inconclusive", "axis": "assessment", "description": "The available evidence cannot establish pass or failure.", "order": 3, "aliases": ["undetermined", "unknown"], "deprecated": false },
    { "id": "not-applicable", "axis": "assessment", "description": "The assessment does not apply to this subject.", "order": 4, "aliases": [], "deprecated": false },
    { "id": "not-assessed", "axis": "assessment", "description": "No assessment has yet been performed.", "order": 5, "aliases": ["not-yet-checked"], "deprecated": false },

    { "id": "improved", "axis": "change", "description": "The observed quality improved from the comparison basis.", "order": 0, "aliases": [], "deprecated": false },
    { "id": "regressed", "axis": "change", "description": "The observed quality regressed from the comparison basis.", "order": 1, "aliases": ["regression"], "deprecated": false },
    { "id": "mixed", "axis": "change", "description": "The comparison contains both improvements and regressions.", "order": 2, "aliases": [], "deprecated": false },
    { "id": "unchanged", "axis": "change", "description": "The observed quality is materially unchanged.", "order": 3, "aliases": ["neutral"], "deprecated": false },
    { "id": "no-observed-delta", "axis": "change", "description": "No quality delta was observed in the available comparison evidence.", "order": 4, "aliases": ["no-quality-delta"], "deprecated": false },
    { "id": "inconclusive", "axis": "change", "description": "The available evidence cannot establish a direction of change.", "order": 5, "aliases": [], "deprecated": false },

    { "id": "allow", "axis": "decision", "description": "The referenced policy permits continuation.", "order": 0, "aliases": [], "deprecated": false },
    { "id": "warn", "axis": "decision", "description": "The referenced policy permits continuation with a warning.", "order": 1, "aliases": [], "deprecated": false },
    { "id": "block", "axis": "decision", "description": "The referenced policy blocks continuation.", "order": 2, "aliases": [], "deprecated": false },
    { "id": "defer", "axis": "decision", "description": "The referenced policy defers a disposition.", "order": 3, "aliases": [], "deprecated": false },

    { "id": "critical", "axis": "severity", "description": "Immediate and severe quality or security impact.", "order": 0, "aliases": [], "deprecated": false },
    { "id": "high", "axis": "severity", "description": "Serious impact requiring prompt action.", "order": 1, "aliases": [], "deprecated": false },
    { "id": "medium", "axis": "severity", "description": "Material impact requiring planned action.", "order": 2, "aliases": [], "deprecated": false },
    { "id": "low", "axis": "severity", "description": "Limited impact or hardening opportunity.", "order": 3, "aliases": [], "deprecated": false },
    { "id": "info", "axis": "severity", "description": "Informational evidence without a defect severity.", "order": 4, "aliases": [], "deprecated": false },

    { "id": "open", "axis": "lifecycle", "description": "The issue is active and unresolved.", "order": 0, "aliases": [], "deprecated": false },
    { "id": "accepted-risk", "axis": "lifecycle", "description": "A human or policy authority explicitly accepted the issue risk.", "order": 1, "aliases": ["accepted"], "deprecated": false },
    { "id": "waived", "axis": "lifecycle", "description": "An authority explicitly waived the issue under stated conditions.", "order": 2, "aliases": [], "deprecated": false },
    { "id": "false-positive", "axis": "lifecycle", "description": "An authority determined that the issue does not represent the claimed problem.", "order": 3, "aliases": ["falsePositive"], "deprecated": false },
    { "id": "resolved", "axis": "lifecycle", "description": "An explicit or policy-backed event established resolution.", "order": 4, "aliases": [], "deprecated": false },

    { "id": "source-code", "axis": "evidence-kind", "description": "Source code or a source-code location.", "order": 0, "aliases": [], "deprecated": false },
    { "id": "test-result", "axis": "evidence-kind", "description": "A test execution result or report.", "order": 1, "aliases": [], "deprecated": false },
    { "id": "runtime-measurement", "axis": "evidence-kind", "description": "A measurement captured from a running system.", "order": 2, "aliases": [], "deprecated": false },
    { "id": "tool-result", "axis": "evidence-kind", "description": "Structured or textual output from a tool or sensor.", "order": 3, "aliases": [], "deprecated": false },
    { "id": "artifact", "axis": "evidence-kind", "description": "A referenced generated or stored artifact.", "order": 4, "aliases": [], "deprecated": false },
    { "id": "document", "axis": "evidence-kind", "description": "A document or preserved text used as evidence.", "order": 5, "aliases": [], "deprecated": false },
    { "id": "human-attestation", "axis": "evidence-kind", "description": "A recorded human attestation.", "order": 6, "aliases": [], "deprecated": false },

    { "id": "code.correctness", "axis": "aspect", "description": "Correctness of code behavior and implementation.", "order": 0, "aliases": ["correctness"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "code.architecture", "axis": "aspect", "description": "Architectural integrity of code structure and dependencies.", "order": 1, "aliases": ["architecture"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "security.general", "axis": "aspect", "description": "General security quality.", "order": 2, "aliases": ["security"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "security.secrets", "axis": "aspect", "description": "Secret material exposure and handling.", "order": 3, "aliases": ["secrets"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "security.dependencies", "axis": "aspect", "description": "Security of third-party dependencies.", "order": 4, "aliases": ["dependencies"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "security.authentication-authorization", "axis": "aspect", "description": "Authentication and authorization controls.", "order": 5, "aliases": ["authentication-authorization"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "security.input-validation", "axis": "aspect", "description": "Validation and safe handling of untrusted input.", "order": 6, "aliases": ["input-validation"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "security.configuration-iac", "axis": "aspect", "description": "Security configuration and infrastructure-as-code.", "order": 7, "aliases": ["configuration-iac"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "security.boundary-exposure", "axis": "aspect", "description": "Exposure and protection of trust boundaries.", "order": 8, "aliases": ["boundaries"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "security.business-logic", "axis": "aspect", "description": "Business-logic security properties evaluated through deep-flow review.", "order": 9, "aliases": [], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "security.attack-coverage", "axis": "aspect", "description": "Coverage of applicable attack classes.", "order": 10, "aliases": [], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "performance.general", "axis": "aspect", "description": "General performance quality.", "order": 11, "aliases": ["performance"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "change.risk", "axis": "aspect", "description": "Risk introduced or reduced by a change.", "order": 12, "aliases": ["risk"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "change.test-evidence", "axis": "aspect", "description": "Strength of test evidence for a change.", "order": 13, "aliases": ["test-evidence"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "change.scope-discipline", "axis": "aspect", "description": "Discipline and coherence of change scope.", "order": 14, "aliases": ["scope-discipline"], "deprecated": false, "allowedAxes": ["assessment"] },
    { "id": "change.architecture-drift", "axis": "aspect", "description": "Architectural drift introduced or reduced by a change.", "order": 15, "aliases": ["architecture-drift"], "deprecated": false, "allowedAxes": ["assessment"] }
  ],
  "extensions": {}
}



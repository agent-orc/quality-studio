<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AgentOrchestrator.CodeQuality</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CodingAgentRunner" Version="0.7.0" />
    <EmbeddedResource Include="prompts/*.md" />
    <EmbeddedResource Include="catalogues/*.json" />
    <Content Include="../../rules/**/*.rule.json" Link="rules/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

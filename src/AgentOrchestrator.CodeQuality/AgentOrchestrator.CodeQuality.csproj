<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AgentOrchestrator.CodeQuality</RootNamespace>
    <PackageId>QualityStudio.Analysis.Core</PackageId>
    <Version>0.1.0</Version>
    <Title>Quality Studio Analysis Core</Title>
    <Description>In-process Quality Studio analysis contracts, sensors, reviewers, and finding models.</Description>
    <PackageTags>quality;analysis;static-analysis;code-review;quality-studio</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CodingAgentRunner" Version="0.7.0" />
    <EmbeddedResource Include="prompts/*.md" />
    <EmbeddedResource Include="catalogues/*.json" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

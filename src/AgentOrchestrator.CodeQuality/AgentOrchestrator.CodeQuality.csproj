<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AgentOrchestrator.CodeQuality</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>AgentOrchestrator.CodeQuality</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Title>Quality Studio Analysis Core</Title>
    <Description>In-process Quality Studio analysis for repository paths, with stable finding contracts and no web-host dependency.</Description>
    <PackageTags>quality;analysis;code-review;sarif;ci</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CodingAgentRunner" Version="0.7.0" />
    <EmbeddedResource Include="prompts/*.md" />
    <EmbeddedResource Include="catalogues/*.json" />
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../schemas/quality-finding.v1.schema.json" Pack="true" PackagePath="/schemas/quality-finding.v1.schema.json" />
  </ItemGroup>
</Project>

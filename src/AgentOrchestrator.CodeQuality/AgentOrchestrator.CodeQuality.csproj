<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AgentOrchestrator.CodeQuality</RootNamespace>
    <PackageId>AgentOrchestrator.CodeQuality</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Description>In-process Quality Studio analysis, finding contracts, sensors, and review orchestration.</Description>
    <PackageTags>quality;analysis;code-review;agent-orchestrator</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CodingAgentRunner" Version="0.7.0" />
    <EmbeddedResource Include="prompts/*.md" />
    <EmbeddedResource Include="catalogues/*.json" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

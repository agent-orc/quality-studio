<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AgentOrchestrator.CodeQuality</RootNamespace>
    <AssemblyName>AgentOrchestrator.CodeQuality</AssemblyName>
    <PackageId>AgentOrchestrator.CodeQuality</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Title>Quality Studio analysis core</Title>
    <Description>In-process repository analysis for Quality Studio, CI, command-line, and Agent Studio pipeline consumers.</Description>
    <PackageTags>quality;analysis;static-analysis;findings;quality-studio</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CodingAgentRunner" Version="0.7.0" />
    <!-- Syntax-only C# parsing for hierarchy derivation. See docs/hierarchy-derivation.md. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <EmbeddedResource Include="prompts/*.md" />
    <EmbeddedResource Include="catalogues/*.json" />
    <!-- Reviewed SHA-256 of each pinned Gitleaks release archive; see docs/security-gitleaks.md. -->
    <EmbeddedResource Include="gitleaks-binaries.json" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

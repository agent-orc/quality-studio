{
  "QualityStudio": {
    "RepositoryRoot": "../..",
    "AllowedRoots": [
      "../.."
    ],
    "GlobalInputsDirectory": null,
    "InputBudgetCharacters": 12000,
    "DefaultReviewTokenCap": 100000,
    "ContentLimits": {
      "SchemaVersion": 1,
      "MaxFileBytes": 1048576,
      "MaxAggregateFiles": 200,
      "MaxAggregateBytes": 4194304,
      "MaxPromptBytes": 6291456,
      "MaxPromptTokens": 1500000,
      "MaxSidecarBytes": 2097152,
      "MaxSidecarAggregateBytes": 16777216,
      "MaxSidecarCount": 2000,
      "MaxResponseBytes": 1048576,
      "MaxFindings": 200,
      "MaxThreads": 200,
      "MaxTextFieldCharacters": 32000
    },
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "Security": {
      "Mode": "Local",
      "RequireHttps": true,
      "MaxRequestBodyBytes": 65536,
      "MaxConcurrentRequests": 32,
      "SpendRequestsPerMinute": 5,
      "CommandBackedAnalyzersEnabled": false,
      "Audience": "quality-studio-api",
      "RevocationFile": null,
      "Clients": []
    },
    "AnalyzerProfiles": []
  },
  "AgentStudio": {
    "BaseUrl": null,
    "ClientId": null,
    "Project": null,
    "DryRun": true
  },
  "ReviewJobs": {
    "MaxConcurrency": 2,
    "RecentRunLimit": 30
  }
}

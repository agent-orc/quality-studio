{
  "QualityStudio": {
    "RepositoryRoot": "../..",
    "AllowedRoots": [
      "../.."
    ],
    "GlobalInputsDirectory": null,
    "InputBudgetCharacters": 12000,
    "DefaultReviewTokenCap": 100000,
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "Security": {
      "Mode": "Local",
      "RequireHttps": true,
      "MaxRequestBodyBytes": 65536,
      "MaxConcurrentRequests": 32,
      "SpendRequestsPerMinute": 5,
      "Clients": []
    }
  },
  "AgentStudio": {
    "BaseUrl": null,
    "ClientId": null,
    "Project": null,
    "DryRun": true
  },
  "ReviewJobs": {
    "MaxConcurrency": 2,
    "RecentRunLimit": 30
  },
  "QualityTaxonomy": {
    "ObservationWriteEnabled": false,
    "ObservationReadEnabled": false,
    "Provider": "unknown",
    "RoutePolicyVersion": "unknown"
  }
}

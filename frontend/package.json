{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve frontend",
    "build": "ng build frontend",
    "watch": "ng build frontend --watch --configuration development",
    "test": "node ./tests/run-tests.mjs",
    "test:coverage": "node ./tests/run-tests.mjs --coverage",
    "lint": "eslint src style-reference tests lint --config eslint.config.mjs",
    "lint:sarif": "eslint src style-reference tests lint --config eslint.config.mjs --format node_modules/@microsoft/eslint-formatter-sarif/sarif.js",
    "test:browser-resolver": "node --test ./tests/browser-binary.test.mjs",
    "perf": "node tests/perf.mjs && node tests/project-switch-perf.mjs",
    "browser:install": "node node_modules/playwright-core/cli.js install chromium",
    "evidence:model-picker": "node tests/model-picker-evidence.mjs",
    "evidence:syntax": "node tests/syntax-evidence.mjs evidence",
    "evidence:exact-span": "node tests/exact-span-evidence.mjs evidence",
    "evidence:security": "node tests/security-evidence.mjs evidence",
    "evidence:repository-modal": "node tests/repository-modal-evidence.mjs",
    "evidence:run-compare": "node tests/run-compare-evidence.mjs",
    "evidence:url-preview-embed": "node tests/url-preview-embed-evidence.mjs",
    "evidence:ignore-list": "node tests/ignore-list-evidence.mjs",
    "shots:run-report": "node tests/shots/run-report-evidence.mjs",
    "test:architecture": "node --test tests/architecture.test.mjs tests/typography.test.mjs",
    "reference": "ng serve style-reference --host 127.0.0.1 --port 4226",
    "build:reference": "ng build style-reference"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "9.39.5",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@types/jasmine": "~5.1.0",
    "@types/prismjs": "^1.26.5",
    "angular-eslint": "20.7.0",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright-core": "^1.61.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.67.0",
    "postcss": "8.5.26"
  }
}

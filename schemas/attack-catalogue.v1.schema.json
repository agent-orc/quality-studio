{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/attack-catalogue.v1.schema.json",
  "title": "Quality Studio attack catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "catalogueVersion", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "catalogueVersion": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "title", "description", "applicability",
        "evidenceRequirements", "severity", "severityFrame",
        "deterministicRuleIds", "enabled"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boundaryKinds"],
          "properties": {
            "boundaryKinds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "directions": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["inbound", "outbound"] }
            }
          }
        },
        "evidenceRequirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "severityFrame": { "type": "string", "minLength": 1 },
        "deterministicRuleIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "deterministicPassConclusive": { "type": "boolean" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-record.v1.schema.json",
  "title": "Quality Studio run-history run record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runId", "repositoryId", "createdAt", "node", "kind", "cliType", "force", "targets"],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-record.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "repositoryId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "name", "path"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "path": { "$ref": "#/$defs/repoPath" }
      }
    },
    "level": { "type": ["string", "null"], "enum": ["project", "module", "namespace", "file", "function", null] },
    "kind": { "enum": ["code", "security", "performance"] },
    "model": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "thinkingLevel": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
    "cliType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "force": { "type": "boolean" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "name", "path", "subjectHash"],
        "properties": {
          "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "name": { "type": "string", "minLength": 1, "maxLength": 500 },
          "path": { "$ref": "#/$defs/repoPath" },
          "subjectHash": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "aggregateControls": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
    "tokenCap": { "type": ["integer", "null"], "minimum": 0 },
    "costCap": { "type": ["number", "null"], "minimum": 0 },
    "estimate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["files", "operations", "promptCharacters", "inputTokens", "outputTokens", "priceStatus", "historySamples", "method"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "operations": { "type": "integer", "minimum": 0 },
        "promptCharacters": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cost": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"], "minLength": 1, "maxLength": 20 },
        "priceStatus": { "type": "string", "minLength": 1, "maxLength": 100 },
        "historySamples": { "type": "integer", "minimum": 0 },
        "method": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "sourceRevision": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "sourceDirty": { "type": ["boolean", "null"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)[^\\\\]+)$"
    }
  }
}

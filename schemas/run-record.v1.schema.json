{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/run-record.v1.schema.json",
  "title": "Quality Studio run-history record v1",
  "description": "Immutable identity, plan and configuration of one review run, captured at .quality/run-history/YYYY-MM/<runId>/run.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "runId", "repositoryId", "createdAt", "kind", "level",
    "scopeUnitId", "path", "targets", "configuration", "cap", "estimate", "sourceRevision"
  ],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/run-record.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "repositoryId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "kind": { "enum": ["code", "security", "performance"] },
    "level": { "enum": ["project", "module", "namespace", "file"] },
    "scopeUnitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "path": { "$ref": "#/$defs/repoPath" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "name", "path", "subjectHash"],
        "properties": {
          "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "name": { "type": "string", "minLength": 1, "maxLength": 500 },
          "path": { "$ref": "#/$defs/repoPath" },
          "subjectHash": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "thinkingLevel", "cliType", "force", "aggregateControls", "aggregateExclusions", "routeOverride"],
      "properties": {
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "thinkingLevel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "cliType": { "type": "string", "minLength": 1, "maxLength": 100 },
        "force": { "type": "boolean" },
        "aggregateControls": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string", "minLength": 1 } }] },
        "aggregateExclusions": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string", "minLength": 1 } }] },
        "routeOverride": { "type": "boolean" }
      }
    },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenLimit", "costLimit"],
      "properties": {
        "tokenLimit": { "$ref": "#/$defs/nullableInteger" },
        "costLimit": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "estimate": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "operations", "inputTokens", "outputTokens", "cost", "currency", "historySamples", "method"],
          "properties": {
            "files": { "type": "integer", "minimum": 0 },
            "operations": { "type": "integer", "minimum": 0 },
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "cost": { "$ref": "#/$defs/nullableNumber" },
            "currency": { "$ref": "#/$defs/nullableString" },
            "historySamples": { "type": "integer", "minimum": 0 },
            "method": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        }
      ]
    },
    "sourceRevision": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "dirty"],
          "properties": {
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            "dirty": { "type": "boolean" }
          }
        }
      ]
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)[^\\\\]+)$" }
  }
}

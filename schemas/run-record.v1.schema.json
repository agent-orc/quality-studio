{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-record.v1.schema.json",
  "title": "Quality Studio archived review run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runId", "repositoryId", "createdAt", "subject", "kind", "targets", "configuration", "sourceRevision", "provenance"],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-record.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/id" },
    "repositoryId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "subject": { "$ref": "#/$defs/subject" },
    "kind": { "enum": ["code", "security", "performance"] },
    "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
    "configuration": { "$ref": "#/$defs/configuration" },
    "sourceRevision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sourceRevision" }] },
    "provenance": { "$ref": "#/$defs/nullableString" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "hash": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }] },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)[^\\\\]+)$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "path", "level"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "path": { "$ref": "#/$defs/repoPath" },
        "level": { "enum": ["project", "module", "namespace", "file"] }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "name", "path", "subjectHash", "promptId", "promptHash", "inputHash"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "path": { "$ref": "#/$defs/repoPath" },
        "subjectHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "promptId": { "$ref": "#/$defs/nullableString" },
        "promptHash": { "$ref": "#/$defs/hash" },
        "inputHash": { "$ref": "#/$defs/hash" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "thinkingLevel", "cliType", "force", "tokenCap", "costCap", "estimate"],
      "properties": {
        "model": { "$ref": "#/$defs/nullableString" },
        "thinkingLevel": { "$ref": "#/$defs/nullableString" },
        "cliType": { "type": "string", "minLength": 1, "maxLength": 100 },
        "force": { "type": "boolean" },
        "tokenCap": { "$ref": "#/$defs/nullableInteger" },
        "costCap": { "$ref": "#/$defs/nullableNumber" },
        "estimate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/estimate" }] }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "operations", "promptCharacters", "inputTokens", "outputTokens", "cost", "currency", "priceStatus", "historySamples", "method", "expectedFreshSkips"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "operations": { "type": "integer", "minimum": 0 },
        "promptCharacters": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cost": { "$ref": "#/$defs/nullableNumber" },
        "currency": { "$ref": "#/$defs/nullableString" },
        "priceStatus": { "type": "string", "minLength": 1 },
        "historySamples": { "type": "integer", "minimum": 0 },
        "method": { "type": "string", "minLength": 1 },
        "expectedFreshSkips": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "$ref": "#/$defs/nullableString" },
        "dirty": { "type": "boolean" }
      }
    }
  }
}

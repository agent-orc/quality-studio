{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-record.v1.schema.json",
  "title": "Quality Studio archived review run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runId", "repositoryId", "createdAt", "subject", "level", "kind", "targets", "configuration", "sourceRevision", "provenance"],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-record.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "repositoryId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "subject": { "$ref": "#/$defs/node" },
    "level": { "enum": ["project", "module", "namespace", "file"] },
    "kind": { "enum": ["code", "security", "performance"] },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
    "configuration": { "$ref": "#/$defs/configuration" },
    "estimate": { "type": ["object", "null"] },
    "tokenCap": { "type": ["integer", "null"], "minimum": 1 },
    "costCap": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "sourceRevision": { "$ref": "#/$defs/revision" },
    "provenance": { "enum": ["native", "migrated-from-run-store-v0"] }
  },
  "$defs": {
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "path"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 } }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "path", "subjectHash"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "subjectHash": { "type": "string", "minLength": 1 } }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "thinkingLevel", "cliType", "force", "routeOverride"],
      "properties": { "model": { "type": ["string", "null"] }, "thinkingLevel": { "type": ["string", "null"] }, "cliType": { "type": "string", "minLength": 1 }, "force": { "type": "boolean" }, "routeOverride": { "type": "boolean" } }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": { "commit": { "type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" }, "dirty": { "type": "boolean" } }
    }
  }
}

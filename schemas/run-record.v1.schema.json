{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-record.v1.schema.json",
  "title": "Quality Studio archived run record v1",
  "description": "Immutable identity, plan and configuration for one review run archived under .quality/run-history/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "runId", "repositoryId", "node", "level", "kind",
    "cliType", "createdAt", "targets", "force"
  ],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-record.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "repositoryId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "node": { "$ref": "#/$defs/node" },
    "level": { "enum": ["project", "module", "namespace", "file"] },
    "kind": { "enum": ["code", "security", "performance"] },
    "model": { "$ref": "#/$defs/nullableString" },
    "thinkingLevel": { "$ref": "#/$defs/nullableString" },
    "cliType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "createdAt": { "type": "string", "format": "date-time" },
    "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
    "tokenCap": { "$ref": "#/$defs/nullableInteger" },
    "costCap": { "$ref": "#/$defs/nullableNumber" },
    "force": { "type": "boolean" },
    "sourceCommit": { "$ref": "#/$defs/nullableString" },
    "sourceDirty": { "type": ["boolean", "null"] }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)[^\\\\]+)$" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "path": { "$ref": "#/$defs/repoPath" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "subjectHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "path": { "$ref": "#/$defs/repoPath" },
        "subjectHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}

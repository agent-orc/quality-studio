{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-record.v1.schema.json",
  "title": "Quality Studio run archive record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runId", "repositoryId", "createdAt", "kind", "level", "scopeUnitId", "path", "targets", "model", "thinkingLevel", "cliType", "force", "tokenCap", "costCap", "estimate", "sourceRevision", "sourceDirty"],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-record.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "repositoryId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "kind": { "enum": ["code", "security", "performance"] },
    "level": { "enum": ["project", "module", "namespace", "file"] },
    "scopeUnitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "path": { "$ref": "#/$defs/repoPath" },
    "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
    "model": { "type": ["string", "null"], "maxLength": 200 },
    "thinkingLevel": { "type": "string", "minLength": 1, "maxLength": 100 },
    "cliType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "force": { "type": "boolean" },
    "tokenCap": { "type": ["integer", "null"], "minimum": 0 },
    "costCap": { "type": ["number", "null"] },
    "estimate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/estimate" }] },
    "sourceRevision": { "type": ["string", "null"], "maxLength": 200 },
    "sourceDirty": { "type": ["boolean", "null"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)[^\\\\]+)$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "name", "path", "subjectHash"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "path": { "$ref": "#/$defs/repoPath" },
        "subjectHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "operations", "inputTokens", "outputTokens", "cost", "currency", "historySamples", "method"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "operations": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cost": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"] },
        "historySamples": { "type": "integer", "minimum": 0 },
        "method": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}

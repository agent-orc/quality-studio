{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/sarif-2.1.0-output.schema.json",
  "title": "SARIF 2.1.0 output profile used by Quality Studio",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "runs"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/Schemata/sarif-schema-2.1.0.json"
    },
    "version": {
      "const": "2.1.0"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["tool", "results"],
      "properties": {
        "tool": {
          "type": "object",
          "required": ["driver"],
          "properties": {
            "driver": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "informationUri": { "type": "string", "format": "uri" },
                "semanticVersion": { "type": "string" },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "automationDetails": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 }
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ruleId", "level", "message"],
            "properties": {
              "ruleId": { "type": "string", "minLength": 1 },
              "level": { "enum": ["none", "note", "warning", "error"] },
              "message": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "minLength": 1 }
                }
              },
              "partialFingerprints": { "type": "object" },
              "locations": { "type": "array" },
              "properties": { "type": "object" },
              "suppressions": { "type": "array" }
            }
          }
        },
        "properties": { "type": "object" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/review-meta.v3.schema.json",
  "title": "Quality Studio review metadata v3",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9.-]*$": true
  },
  "required": [
    "$schema",
    "schemaVersion",
    "unit",
    "reviewedAt",
    "kind",
    "reviewer",
    "reviewedHash",
    "subjectInputs",
    "reviewInputs",
    "grade",
    "summary",
    "aspects",
    "findings",
    "origin"
  ],
  "properties": {
    "$schema": {
      "const": "https://agent-orchestrator.dev/quality/schemas/review-meta.v3.schema.json"
    },
    "schemaVersion": {
      "const": 3
    },
    "unit": {
      "$ref": "#/$defs/unit"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "kind": {
      "enum": [
        "code",
        "security",
        "performance"
      ]
    },
    "reviewer": {
      "$ref": "#/$defs/reviewer"
    },
    "reviewedHash": {
      "$ref": "#/$defs/subjectManifestHash"
    },
    "subjectInputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/subjectInput"
      }
    },
    "reviewInputs": {
      "$ref": "#/$defs/reviewInputs"
    },
    "grade": {
      "$ref": "#/$defs/grade"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/aspect"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thread"
      }
    },
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    },
    "security": {
      "$ref": "#/$defs/securityReview"
    },
    "deterministicEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deterministicSensorResult"
      }
    },
    "origin": {
      "$ref": "#/$defs/origin"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "object",
            "properties": {
              "level": {
                "enum": [
                  "project",
                  "module",
                  "namespace"
                ]
              }
            },
            "required": [
              "level"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "aggregate": {
            "$ref": "#/$defs/aggregate"
          },
          "subjectInputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "selector": {
                  "enum": [
                    "aggregate-control",
                    "aggregate-members"
                  ]
                }
              },
              "required": [
                "selector"
              ]
            },
            "contains": {
              "type": "object",
              "properties": {
                "selector": {
                  "const": "aggregate-members"
                }
              },
              "required": [
                "selector"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        },
        "required": [
          "aggregate"
        ]
      },
      "else": {
        "type": "object",
        "not": {
          "type": "object",
          "properties": {
            "aggregate": true
          },
          "required": [
            "aggregate"
          ]
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "object",
            "properties": {
              "level": {
                "const": "function"
              }
            },
            "required": [
              "level"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "object",
            "properties": {
              "symbolId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "symbolId"
            ]
          },
          "subjectInputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "selector": {
                  "oneOf": [
                    {
                      "const": "file"
                    },
                    {
                      "type": "string",
                      "pattern": "^symbol:(?:[A-Za-z0-9._~-]|%[A-F0-9]{2})+$"
                    }
                  ]
                }
              },
              "required": [
                "selector"
              ]
            },
            "contains": {
              "type": "object",
              "properties": {
                "selector": {
                  "type": "string",
                  "pattern": "^symbol:(?:[A-Za-z0-9._~-]|%[A-F0-9]{2})+$"
                }
              },
              "required": [
                "selector"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "object",
            "not": {
              "type": "object",
              "properties": {
                "symbolId": true
              },
              "required": [
                "symbolId"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "object",
            "properties": {
              "level": {
                "const": "file"
              }
            },
            "required": [
              "level"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "subjectInputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "selector": {
                  "const": "file"
                }
              },
              "required": [
                "selector"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "unit": {
            "properties": {
              "level": {
                "const": "file"
              }
            },
            "required": [
              "level"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "evidenceItems": {
                  "contains": {
                    "properties": {
                      "class": {
                        "const": "source-span"
                      }
                    },
                    "required": [
                      "class"
                    ]
                  },
                  "minContains": 1
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "sha256String": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "subjectManifestHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "quality-studio-subject-manifest-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "inputManifestHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "quality-studio-review-inputs-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapter",
        "level",
        "path",
        "displayName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^qs-v1/(angular|dotnet|generic)/(project|module|namespace|file|function)/[a-f0-9]{64}$"
        },
        "adapter": {
          "enum": [
            "angular",
            "dotnet",
            "generic"
          ]
        },
        "level": {
          "enum": [
            "project",
            "module",
            "namespace",
            "file",
            "function"
          ]
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "symbolId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "model"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "agentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "usage": {
          "$ref": "#/$defs/tokenUsage"
        },
        "sensors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reviewerSensor"
          }
        },
        "thinkingLevel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "reviewerSensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "resultHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resultHash": {
          "$ref": "#/$defs/sha256String"
        }
      }
    },
    "securityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "combinationRule",
        "sensors"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "warn",
            "block",
            "unavailable"
          ]
        },
        "combinationRule": {
          "const": "security-sensor-agent-v1"
        },
        "sensors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/securitySensor"
          }
        }
      }
    },
    "securitySensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "resultHash",
        "available",
        "unavailableReason",
        "verdict",
        "toolVersions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resultHash": {
          "$ref": "#/$defs/sha256String"
        },
        "available": {
          "type": "boolean"
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        },
        "verdict": {
          "enum": [
            "pass",
            "warn",
            "block",
            "unavailable"
          ]
        },
        "toolVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "deterministicSensorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "unavailableReason",
        "findings",
        "provenance"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        },
        "findings": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/sensorFinding"
              },
              {
                "required": [
                  "fingerprint",
                  "ruleId",
                  "source"
                ]
              }
            ]
          }
        },
        "provenance": {
          "$ref": "#/$defs/deterministicSensorProvenance"
        }
      }
    },
    "deterministicSensorProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensorId",
        "sensorVersion",
        "scope",
        "target",
        "scannedAt",
        "toolVersions"
      ],
      "properties": {
        "sensorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sensorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scope": {
          "enum": [
            "repository",
            "path"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scannedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "toolVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cliType",
        "inputTokens",
        "outputTokens",
        "cachedInputTokens",
        "reasoningOutputTokens",
        "durationMs"
      ],
      "properties": {
        "cliType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoningOutputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "subjectInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "selector",
        "contentHash"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "selector": {
          "oneOf": [
            {
              "const": "file"
            },
            {
              "const": "aggregate-control"
            },
            {
              "const": "aggregate-members"
            },
            {
              "type": "string",
              "pattern": "^symbol:(?:[A-Za-z0-9._~-]|%[A-F0-9]{2})+$",
              "maxLength": 2000
            }
          ]
        },
        "contentHash": {
          "$ref": "#/$defs/sha256String"
        }
      }
    },
    "standardReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "version",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
        },
        "scope": {
          "enum": [
            "built-in",
            "global",
            "project"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contentHash": {
          "$ref": "#/$defs/sha256String"
        }
      }
    },
    "promptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contentHash": {
          "$ref": "#/$defs/sha256String"
        }
      }
    },
    "reviewInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectiveHash",
        "complete",
        "standards",
        "omitted",
        "prompt"
      ],
      "properties": {
        "effectiveHash": {
          "$ref": "#/$defs/inputManifestHash"
        },
        "complete": {
          "type": "boolean"
        },
        "standards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standardReference"
          }
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
          }
        },
        "prompt": {
          "$ref": "#/$defs/promptReference"
        }
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "band",
        "rationale"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "band": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 90
            },
            "band": {
              "const": "A"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 80,
              "maximum": 89
            },
            "band": {
              "const": "B"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 70,
              "maximum": 79
            },
            "band": {
              "const": "C"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 60,
              "maximum": 69
            },
            "band": {
              "const": "D"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "maximum": 59
            },
            "band": {
              "const": "F"
            }
          }
        }
      ]
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "grade"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "grade": {
          "$ref": "#/$defs/grade"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "symbolId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "role": {
          "enum": [
            "primary",
            "related"
          ]
        },
        "capturedExcerpt": {
          "$ref": "#/$defs/capturedExcerpt"
        }
      },
      "dependentRequired": {
        "range": [
          "capturedExcerpt"
        ]
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aspect",
        "severity",
        "title",
        "description",
        "recommendation",
        "locations",
        "fingerprint",
        "ruleId",
        "impact",
        "evidenceItems",
        "reproduction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256String"
        },
        "aspect": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,63}$"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "source": {
          "$ref": "#/$defs/findingSource"
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "evidenceItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "reproduction": {
          "$ref": "#/$defs/reproduction"
        }
      }
    },
    "findingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sensorId",
        "producer"
      ],
      "properties": {
        "kind": {
          "const": "deterministic"
        },
        "sensorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "anchor",
        "status",
        "entries"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "anchor": {
          "$ref": "#/$defs/threadAnchor"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "anchorState": {
          "enum": [
            "anchored",
            "healed",
            "detached"
          ]
        },
        "healedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/threadEntry"
          }
        }
      }
    },
    "threadAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "fingerprint",
        "contextHash",
        "lastKnownRange"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256String"
        },
        "contextHash": {
          "$ref": "#/$defs/sha256String"
        },
        "lastKnownRange": {
          "$ref": "#/$defs/range"
        }
      }
    },
    "threadEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "author",
        "createdAt",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "author": {
          "$ref": "#/$defs/threadAuthor"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "threadAuthor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "agent",
              "model"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "human"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "name"
            ]
          }
        }
      ]
    },
    "aggregateMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitId",
        "path",
        "subjectHash"
      ],
      "properties": {
        "unitId": {
          "type": "string",
          "pattern": "^qs-v1/(angular|dotnet|generic)/file/[a-f0-9]{64}$"
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "subjectHash": {
          "$ref": "#/$defs/sha256String"
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members",
        "excluded"
      ],
      "properties": {
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/aggregateMember"
          }
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exclusion"
          }
        }
      }
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "capturedExcerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "language",
        "contentHash",
        "excerptHash"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contentHash": {
          "$ref": "#/$defs/sha256String"
        },
        "excerptHash": {
          "$ref": "#/$defs/sha256String"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "status",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "class": {
          "enum": [
            "source-span",
            "deterministic-result",
            "test-result",
            "runtime-observation",
            "external-reference",
            "legacy-claim"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "verified",
            "specified",
            "unverified"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "anchorIndex": {
          "type": "integer",
          "minimum": 0
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "resultHash": {
          "$ref": "#/$defs/sha256String"
        }
      }
    },
    "reproductionAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executedAt",
        "executor",
        "result"
      ],
      "properties": {
        "executedAt": {
          "$ref": "#/$defs/utc"
        },
        "executor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "artifactReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "steps",
        "attempts"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "specified",
            "not-applicable",
            "blocked",
            "unknown"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "observed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reproductionAttempt"
          }
        }
      }
    },
    "sensorFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aspect",
        "severity",
        "title",
        "description",
        "recommendation",
        "locations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256String"
        },
        "aspect": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,63}$"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "source": {
          "$ref": "#/$defs/findingSource"
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sensorLocation"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cli": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "thinkingLevel": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operationRunId",
        "requested",
        "executed",
        "prompt",
        "reviewInputHash",
        "subjectManifestHash",
        "sourceRevision",
        "observedAt"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "deterministic"
          ]
        },
        "reviewRunId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "operationRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requested": {
          "$ref": "#/$defs/route"
        },
        "executed": {
          "$ref": "#/$defs/route"
        },
        "prompt": {
          "$ref": "#/$defs/promptReference"
        },
        "reviewInputHash": {
          "$ref": "#/$defs/sha256String"
        },
        "subjectManifestHash": {
          "$ref": "#/$defs/sha256String"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^(?:git:[a-f0-9]{40}(?:\\+uncommitted)?|unknown)$"
        },
        "observedAt": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "sensorLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "symbolId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}

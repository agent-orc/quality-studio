{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-finding.v1.schema.json",
  "title": "Quality Studio archived review run finding observation v1",
  "description": "Append-only record of what one operation observed, including its lifecycle state at observation time. Never the current lifecycle owner; .quality/findings/state.json remains that.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "operationId", "fingerprint", "findingId", "ruleId", "severity", "title", "locations", "state"
  ],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-finding.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "fingerprint": { "type": "string", "minLength": 1 },
    "findingId": { "type": "string", "minLength": 1 },
    "ruleId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } },
    "state": { "enum": ["open", "accepted", "waived", "false-positive", "resolved"] }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "range": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/position" },
            "end": { "$ref": "#/$defs/position" }
          }
        },
        "symbolId": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

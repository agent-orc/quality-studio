{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/run-finding.v1.schema.json",
  "title": "Quality Studio archived review finding observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runId", "operationId", "fingerprint", "findingId", "ruleId", "severity", "title", "locations", "state"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/run-finding.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/id" },
    "operationId": { "$ref": "#/$defs/id" },
    "fingerprint": { "$ref": "#/$defs/sha256" },
    "findingId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "ruleId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "locations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "startLine", "startColumn", "endLine", "endColumn"],
        "properties": {
          "path": { "$ref": "#/$defs/repoPath" },
          "startLine": { "$ref": "#/$defs/nullablePositiveInteger" },
          "startColumn": { "$ref": "#/$defs/nullablePositiveInteger" },
          "endLine": { "$ref": "#/$defs/nullablePositiveInteger" },
          "endColumn": { "$ref": "#/$defs/nullablePositiveInteger" }
        }
      }
    },
    "state": { "enum": ["open", "accepted", "waived", "false-positive", "resolved"] }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullablePositiveInteger": { "type": ["integer", "null"], "minimum": 1 },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+)$" }
  }
}

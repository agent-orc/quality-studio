{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-finding.v1.schema.json",
  "title": "Quality Studio archived finding observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "operationId", "attempt", "fingerprint", "findingId", "ruleId", "severity", "title", "locations", "stateAtObservation"],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-finding.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "findingId": { "type": "string", "minLength": 1 },
    "ruleId": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "title": { "type": "string", "minLength": 1 },
    "locations": { "type": "array", "items": { "type": "object" } },
    "stateAtObservation": { "enum": ["open", "accepted", "waived", "false-positive", "resolved"] }
  }
}

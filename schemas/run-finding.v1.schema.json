{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-finding.v1.schema.json",
  "title": "Quality Studio run-history finding observation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "operationId",
    "runId",
    "fingerprint",
    "findingId",
    "ruleId",
    "severity",
    "title",
    "state",
    "locations",
    "observedAt"
  ],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-finding.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "fingerprint": { "$ref": "#/$defs/sha256String" },
    "findingId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "ruleId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "state": { "enum": ["open", "accepted", "waived", "false-positive", "resolved"] },
    "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } },
    "observedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "nullableInteger": { "type": ["integer", "null"] },
    "sha256String": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "startLine": { "$ref": "#/$defs/nullableInteger" },
        "startColumn": { "$ref": "#/$defs/nullableInteger" },
        "endLine": { "$ref": "#/$defs/nullableInteger" },
        "endColumn": { "$ref": "#/$defs/nullableInteger" }
      }
    }
  }
}

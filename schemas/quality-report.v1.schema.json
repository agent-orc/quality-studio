{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/quality-report.v1.json",
  "title": "Quality Studio quality report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "generatedAt", "repositories", "comparison"],
  "properties": {
    "$schema": {
      "const": "https://agent-orchestrator.dev/quality/schemas/quality-report.v1.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "comparison": {
      "type": "object",
      "required": ["repositories"],
      "properties": {
        "repositories": {
          "type": "array"
        }
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "required": ["id", "name", "scorecard", "trend", "findings"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "scorecard": {
          "type": "object",
          "description": "Descriptive projection over the review sidecars that currently exist. It is never stored or displayed as the grade of a reviewed unit, and it does not replace a project or module review statement.",
          "required": ["score", "grade", "kinds", "findings", "staleness", "coverage", "sensors"],
          "properties": {
            "aggregateScore": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Rounded mean over the kinds that have review evidence. Written by every current producer." },
            "aggregateBand": { "enum": ["A", "B", "C", "D", "F"], "description": "Band of aggregateScore. It labels the projection, not a reviewed unit." },
            "score": { "type": "integer", "minimum": 0, "maximum": 100, "deprecated": true, "description": "Deprecated alias of aggregateScore, kept for existing consumers." },
            "grade": { "enum": ["A", "B", "C", "D", "F"], "deprecated": true, "description": "Deprecated alias of aggregateBand, kept for existing consumers." },
            "kinds": { "type": "array" },
            "findings": { "type": "object" },
            "staleness": { "type": "object" },
            "coverage": { "type": "object" },
            "sensors": { "type": "array" }
          }
        },
        "trend": { "type": "array" },
        "findings": { "type": "array" }
      }
    }
  }
}

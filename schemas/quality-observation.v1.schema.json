{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-observation.v1.schema.json",
  "title": "Quality Studio immutable observation",
  "description": "One producer's immutable result for one exact subject and input set. Append-only: never overwritten or deleted by a later observation.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "required": [
    "$schema", "schemaVersion", "observationId", "taxonomy", "subject", "profile",
    "producer", "evidenceStatus", "evidence", "aspects", "assessment", "findings"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "observationId": { "type": "string", "pattern": "^observation-sha256:[0-9a-f]{64}$" },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "manifestHash"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1 },
        "manifestHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "promptHash", "reviewInputsHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "promptHash": { "$ref": "#/$defs/sha256" },
        "reviewInputsHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "agent", "provider", "requestedModel", "effectiveModel",
        "thinkingLevel", "routePolicyVersion", "runId", "reviewRunId"
      ],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "agent": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "requestedModel": { "type": "string", "minLength": 1 },
        "effectiveModel": { "type": "string", "minLength": 1 },
        "thinkingLevel": { "type": "string", "minLength": 1 },
        "routePolicyVersion": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "reviewRunId": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceStatus": { "enum": ["available", "partial", "unavailable"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "locator", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "source-code", "test-result", "runtime-measurement", "tool-result",
              "artifact", "document", "human-attestation"
            ]
          },
          "locator": { "type": "object" },
          "summary": { "type": "string", "minLength": 1 },
          "contentHash": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "aspects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["aspectId", "assessment", "rationale"],
        "properties": {
          "aspectId": { "type": "string", "minLength": 1 },
          "assessment": { "$ref": "#/$defs/assessment" },
          "rationale": { "type": "string", "minLength": 1 },
          "grade": {
            "type": "object",
            "additionalProperties": false,
            "required": ["score", "band"],
            "properties": {
              "score": { "type": "integer", "minimum": 0, "maximum": 100 },
              "band": { "enum": ["A", "B", "C", "D", "F"] }
            }
          }
        }
      }
    },
    "assessment": { "$ref": "#/$defs/assessment" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observationFindingId", "occurrenceFingerprint", "fingerprintAlgorithm",
          "aspectId", "severity", "evidenceRefs", "source"
        ],
        "properties": {
          "observationFindingId": { "type": "string", "minLength": 1 },
          "issueId": { "type": "string", "minLength": 1 },
          "occurrenceFingerprint": { "$ref": "#/$defs/sha256" },
          "fingerprintAlgorithm": { "type": "string", "minLength": 1 },
          "ruleRef": { "type": "string", "minLength": 1 },
          "aspectId": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "producerRef"],
            "properties": {
              "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
              "producerRef": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assessment": { "enum": ["pass", "concern", "fail", "inconclusive", "not-applicable", "not-assessed"] }
  }
}

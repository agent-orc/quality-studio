{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-observation.v1.schema.json",
  "title": "Quality Studio immutable quality observation v1",
  "description": "One producer's result for one exact subject and input set. Append-only; never overwritten or deleted by another observation.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9.-]*$": true
  },
  "required": [
    "$schema", "schemaVersion", "observationId", "taxonomy", "subject", "profile",
    "producer", "evidenceStatus", "evidence", "aspects", "assessment", "findings"
  ],
  "properties": {
    "$schema": {
      "const": "https://quality.studio/schemas/quality-observation.v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "observationId": { "type": "string", "minLength": 1 },
    "taxonomy": { "$ref": "#/$defs/taxonomyRef" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "manifestHash"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1 },
        "manifestHash": { "type": "string", "minLength": 1 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "promptHash", "reviewInputsHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "promptHash": { "type": "string", "minLength": 1 },
        "reviewInputsHash": { "type": "string", "minLength": 1 }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "agent": { "type": "string" },
        "provider": { "type": "string" },
        "requestedModel": { "type": "string" },
        "effectiveModel": { "type": "string" },
        "thinkingLevel": { "type": "string" },
        "routePolicyVersion": { "type": "string" },
        "runId": { "type": "string" },
        "reviewRunId": { "type": "string" }
      }
    },
    "evidenceStatus": { "enum": ["available", "partial", "unavailable"] },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "aspects": {
      "type": "array",
      "items": { "$ref": "#/$defs/aspectAssessment" }
    },
    "assessment": { "enum": ["pass", "concern", "fail", "inconclusive", "not-applicable", "not-assessed"] },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "taxonomyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "digest": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "source-code", "test-result", "runtime-measurement", "tool-result",
            "artifact", "document", "human-attestation"
          ]
        },
        "locator": { "type": "object" },
        "summary": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string" }
      }
    },
    "aspectAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectId", "assessment", "rationale"],
      "properties": {
        "aspectId": { "type": "string", "minLength": 1 },
        "assessment": { "enum": ["pass", "concern", "fail", "inconclusive", "not-applicable", "not-assessed"] },
        "rationale": { "type": "string", "minLength": 1 },
        "grade": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "band"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 100 },
            "band": { "enum": ["A", "B", "C", "D", "F"] }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationFindingId", "issueId", "occurrenceFingerprint", "fingerprintAlgorithm",
        "aspectId", "severity", "evidenceRefs", "source"
      ],
      "properties": {
        "observationFindingId": { "type": "string", "minLength": 1 },
        "issueId": { "type": "string", "minLength": 1 },
        "occurrenceFingerprint": { "type": "string", "minLength": 1 },
        "fingerprintAlgorithm": { "type": "string", "minLength": 1 },
        "ruleRef": { "type": "string" },
        "aspectId": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "producerRef"],
          "properties": {
            "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
            "producerRef": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}

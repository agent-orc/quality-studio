{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-observation.v1.schema.json",
  "title": "Quality Studio immutable quality observation",
  "description": "One producer's result for one exact subject and input set. Observations are append-only; a model rerun creates another observation and never overwrites or deletes an earlier one.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9.-]*$": true
  },
  "required": [
    "$schema", "schemaVersion", "observationId", "taxonomy", "subject", "profile",
    "producer", "evidenceStatus", "evidence", "aspects", "assessment", "findings"
  ],
  "properties": {
    "$schema": {
      "const": "https://quality.studio/schemas/quality-observation.v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "observationId": {
      "type": "string",
      "pattern": "^observation-sha256:[a-f0-9]{64}$"
    },
    "taxonomy": { "$ref": "#/$defs/taxonomyReference" },
    "subject": { "$ref": "#/$defs/subjectReference" },
    "profile": { "$ref": "#/$defs/profileReference" },
    "producer": { "$ref": "#/$defs/producer" },
    "evidenceStatus": { "$ref": "#/$defs/evidenceStatus" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aspectResult" }
    },
    "assessment": { "$ref": "#/$defs/assessment" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/observationFinding" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256String": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "assessment": {
      "enum": ["pass", "concern", "fail", "inconclusive", "not-applicable", "not-assessed"]
    },
    "evidenceStatus": {
      "enum": ["available", "partial", "unavailable"]
    },
    "severity": {
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "taxonomyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "const": "quality-studio/core" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": { "$ref": "#/$defs/sha256String" }
      }
    },
    "subjectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "manifestHash"],
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "manifestHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "profileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "promptHash", "reviewInputsHash"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "promptHash": { "$ref": "#/$defs/sha256String" },
        "reviewInputsHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requestedModel", "effectiveModel", "thinkingLevel", "routePolicyVersion", "runId"],
      "properties": {
        "kind": {
          "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"]
        },
        "agent": { "type": "string", "minLength": 1, "maxLength": 200 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
        "requestedModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "effectiveModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "thinkingLevel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "routePolicyVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reviewRunId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": {
          "enum": [
            "source-code", "test-result", "runtime-measurement", "tool-result",
            "artifact", "document", "human-attestation"
          ]
        },
        "locator": {
          "type": "object",
          "additionalProperties": true
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "contentHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "aspectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectId", "assessment", "rationale"],
      "properties": {
        "aspectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "assessment": { "$ref": "#/$defs/assessment" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "grade": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "band"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "band": { "enum": ["A", "B", "C", "D", "F"] }
          }
        }
      }
    },
    "findingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producerRef"],
      "properties": {
        "kind": {
          "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"]
        },
        "producerRef": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "observationFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationFindingId", "issueId", "occurrenceFingerprint", "fingerprintAlgorithm",
        "aspectId", "severity", "evidenceRefs", "source"
      ],
      "properties": {
        "observationFindingId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "issueId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "occurrenceFingerprint": { "$ref": "#/$defs/sha256String" },
        "fingerprintAlgorithm": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ruleRef": { "type": "string", "minLength": 1, "maxLength": 200 },
        "aspectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "severity": { "$ref": "#/$defs/severity" },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "source": { "$ref": "#/$defs/findingSource" }
      }
    }
  }
}

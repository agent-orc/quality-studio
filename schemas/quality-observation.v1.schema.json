{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-observation.v1.schema.json",
  "title": "Quality Studio immutable quality observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "observationId", "taxonomy", "subject", "profile",
    "producer", "evidenceStatus", "evidence", "aspects", "assessment", "findings"
  ],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-observation.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "observationId": { "type": "string", "pattern": "^observation-sha256:[a-f0-9]{64}$" },
    "taxonomy": { "$ref": "#/$defs/taxonomyReference" },
    "extensionCatalogues": {
      "type": "array",
      "items": { "$ref": "#/$defs/taxonomyReference" }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "manifestHash"],
      "properties": {
        "unitId": {
          "type": "string",
          "pattern": "^qs-v1/(angular|dotnet|generic)/(project|module|namespace|file|function)/[a-f0-9]{64}$"
        },
        "manifestHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "promptHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "promptHash": { "$ref": "#/$defs/sha256String" },
        "reviewInputsHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "agent": { "type": "string", "minLength": 1, "maxLength": 200 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
        "requestedModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "effectiveModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "thinkingLevel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "routePolicyVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reviewRunId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "evidenceStatus": { "enum": ["available", "partial", "unavailable"] },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aspectResult" }
    },
    "assessment": { "$ref": "#/$defs/assessment" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256String": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "assessment": { "enum": ["pass", "concern", "fail", "inconclusive", "not-applicable", "not-assessed"] },
    "taxonomyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "digest": { "$ref": "#/$defs/sha256String" }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "evidenceLocator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/range" },
        "symbolId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "artifactRef": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": {
          "enum": [
            "source-code", "test-result", "runtime-measurement",
            "tool-result", "artifact", "document", "human-attestation"
          ]
        },
        "locator": { "$ref": "#/$defs/evidenceLocator" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "contentHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "band", "rationale"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "enum": ["A", "B", "C", "D", "F"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "aspectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectId", "assessment", "rationale"],
      "properties": {
        "aspectId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "assessment": { "$ref": "#/$defs/assessment" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "grade": { "$ref": "#/$defs/grade" }
      }
    },
    "findingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producerRef"],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "producerRef": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationFindingId", "aspectId", "severity", "evidenceRefs", "source"],
      "properties": {
        "observationFindingId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "issueId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "occurrenceFingerprint": { "$ref": "#/$defs/sha256String" },
        "fingerprintAlgorithm": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ruleRef": { "type": "string", "minLength": 1, "maxLength": 300 },
        "aspectId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "source": { "$ref": "#/$defs/findingSource" }
      }
    }
  }
}

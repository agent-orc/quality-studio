{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-observation.v1.schema.json",
  "title": "Quality Studio immutable quality observation v1",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-[a-z0-9][a-z0-9.-]*$": true },
  "required": [
    "$schema", "schemaVersion", "observationId", "taxonomy", "subject", "profile", "producer",
    "evidenceStatus", "evidence", "aspects", "assessment", "findings"
  ],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-observation.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "observationId": { "type": "string", "pattern": "^observation-sha256:[a-f0-9]{64}$" },
    "taxonomy": { "$ref": "#/$defs/taxonomyReference" },
    "extensionCatalogues": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/taxonomyReference" }
    },
    "subject": { "$ref": "#/$defs/subject" },
    "profile": { "$ref": "#/$defs/profile" },
    "producer": { "$ref": "#/$defs/producer" },
    "evidenceStatus": { "enum": ["available", "partial", "unavailable"] },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aspect" }
    },
    "assessment": { "$ref": "#/$defs/assessment" },
    "change": { "enum": ["improved", "regressed", "mixed", "unchanged", "no-observed-delta", "inconclusive"] },
    "decision": { "$ref": "#/$defs/decision" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "legacy": { "$ref": "#/$defs/legacy" },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[a-z][a-z0-9-]*\\.)+[a-z][a-z0-9-]*(?::[a-z0-9][a-z0-9._-]*)?$"
      },
      "additionalProperties": true
    },
    "taxonomyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "$ref": "#/$defs/semver" },
        "digest": { "$ref": "#/$defs/hash" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "manifestHash"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "manifestHash": { "$ref": "#/$defs/hash" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "promptHash", "reviewInputsHash"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "version": { "$ref": "#/$defs/semver" },
        "promptHash": { "$ref": "#/$defs/hash" },
        "reviewInputsHash": { "$ref": "#/$defs/hash" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "agent", "provider", "requestedModel", "effectiveModel", "thinkingLevel", "routePolicyVersion"
      ],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "agent": { "type": "string", "minLength": 1, "maxLength": 200 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
        "requestedModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "effectiveModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "thinkingLevel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "routePolicyVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "modelRevision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reviewRunId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "symbolId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "artifactRef": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "uri": { "type": "string", "format": "uri", "maxLength": 4000 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "anyOf": [
        { "required": ["path"] },
        { "required": ["artifactRef"] },
        { "required": ["uri"] }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "kind": {
          "enum": [
            "source-code", "test-result", "runtime-measurement", "tool-result", "artifact", "document",
            "human-attestation"
          ]
        },
        "locator": { "$ref": "#/$defs/locator" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "contentHash": { "$ref": "#/$defs/hash" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 },
        "payload": true,
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "assessment": {
      "enum": ["pass", "concern", "fail", "inconclusive", "not-applicable", "not-assessed"]
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "band"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "enum": ["A", "B", "C", "D", "F"] }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectId", "assessment", "rationale"],
      "properties": {
        "aspectId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9-]*\\.)*[a-z][a-z0-9-]*(?::[a-z0-9][a-z0-9.-]*)?$"
        },
        "assessment": { "$ref": "#/$defs/assessment" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "grade": { "$ref": "#/$defs/grade" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producerRef"],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "producerRef": { "type": "string", "minLength": 1, "maxLength": 200 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationFindingId", "issueId", "occurrenceFingerprint", "fingerprintAlgorithm", "ruleRef",
        "aspectId", "severity", "evidenceRefs", "source"
      ],
      "properties": {
        "observationFindingId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "issueId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "occurrenceFingerprint": { "$ref": "#/$defs/hash" },
        "fingerprintAlgorithm": { "type": "string", "minLength": 1, "maxLength": 200 },
        "ruleRef": { "type": "string", "minLength": 1, "maxLength": 500 },
        "aspectId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "source": { "$ref": "#/$defs/source" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "policyRef"],
      "properties": {
        "value": { "enum": ["allow", "warn", "block", "defer"] },
        "policyRef": { "type": "string", "minLength": 1, "maxLength": 300 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "value", "sourcePath", "completeness"],
      "properties": {
        "schema": { "type": "string", "minLength": 1, "maxLength": 300 },
        "value": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sourcePath": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "completeness": { "enum": ["complete", "partial"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    }
  }
}

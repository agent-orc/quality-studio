{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-observation.v1.schema.json",
  "title": "Quality Studio quality observation",
  "description": "One producer's immutable result for one exact subject and input set. Never overwritten or deleted by another run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "observationId", "taxonomy", "subject", "profile",
    "producer", "evidenceStatus", "evidence", "aspects", "assessment", "findings"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "observationId": { "type": "string", "pattern": "^observation-sha256:[a-f0-9]{64}$" },
    "taxonomy": { "$ref": "#/$defs/taxonomyReference" },
    "extensionCatalogues": {
      "type": "array",
      "items": { "$ref": "#/$defs/taxonomyReference" }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "manifestHash"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1 },
        "manifestHash": { "$ref": "#/$defs/manifestHash" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "promptHash", "reviewInputsHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "promptHash": { "type": "string", "minLength": 1 },
        "reviewInputsHash": { "type": "string", "minLength": 1 }
      }
    },
    "producer": { "$ref": "#/$defs/producer" },
    "evidenceStatus": { "enum": ["available", "partial", "unavailable"] },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "aspects": {
      "type": "array",
      "items": { "$ref": "#/$defs/aspectResult" }
    },
    "assessment": { "$ref": "#/$defs/assessment" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/findingResult" }
    },
    "legacy": { "$ref": "#/$defs/legacyProvenance" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "assessment": { "enum": ["pass", "concern", "fail", "inconclusive", "not-applicable", "not-assessed"] },
    "manifestHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "taxonomyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "agent": { "type": "string" },
        "provider": { "type": "string" },
        "requestedModel": { "type": "string" },
        "effectiveModel": { "type": "string" },
        "thinkingLevel": { "type": "string" },
        "routePolicyVersion": { "type": "string" },
        "runId": { "type": "string" },
        "reviewRunId": { "type": "string" },
        "extensions": { "type": "object" }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "source-code", "test-result", "runtime-measurement", "tool-result",
            "artifact", "document", "human-attestation"
          ]
        },
        "locator": { "type": "object" },
        "summary": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string" },
        "mediaType": { "type": "string" },
        "legacyRaw": { "type": "string" },
        "extensions": { "type": "object" }
      }
    },
    "aspectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectId", "assessment"],
      "properties": {
        "aspectId": { "type": "string", "minLength": 1 },
        "assessment": { "$ref": "#/$defs/assessment" },
        "rationale": { "type": "string" },
        "grade": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": { "type": "number" },
            "band": { "type": "string" }
          }
        },
        "extensions": { "type": "object" }
      }
    },
    "findingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationFindingId", "occurrenceFingerprint", "fingerprintAlgorithm",
        "ruleRef", "aspectId", "severity", "source"
      ],
      "properties": {
        "observationFindingId": { "type": "string", "minLength": 1 },
        "issueId": { "type": "string" },
        "occurrenceFingerprint": { "type": "string", "minLength": 1 },
        "fingerprintAlgorithm": { "type": "string", "minLength": 1 },
        "ruleRef": { "type": "string", "minLength": 1 },
        "aspectId": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
            "producerRef": { "type": "string" }
          }
        },
        "extensions": { "type": "object" }
      }
    },
    "legacyProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "value", "sourcePath", "completeness"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "completeness": { "enum": ["complete", "partial"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-observation.v1.schema.json",
  "title": "Quality Studio immutable quality observation v1",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9.-]*$": true
  },
  "required": [
    "$schema", "schemaVersion", "observationId", "taxonomy", "subject", "profile",
    "producer", "evidenceStatus", "evidence", "aspects", "assessment", "findings"
  ],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-observation.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "observationId": { "type": "string", "minLength": 1, "maxLength": 300 },
    "taxonomy": { "$ref": "#/$defs/taxonomyRef" },
    "subject": { "$ref": "#/$defs/subject" },
    "profile": { "$ref": "#/$defs/profile" },
    "producer": { "$ref": "#/$defs/producer" },
    "evidenceStatus": { "enum": ["available", "partial", "unavailable"] },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "aspects": {
      "type": "array",
      "items": { "$ref": "#/$defs/aspectObservation" }
    },
    "assessment": { "$ref": "#/$defs/assessment" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/observationFinding" }
    },
    "extensions": {
      "type": "object",
      "description": "Preserved extension-catalogue data keyed by reverse-DNS extension id. Never redefines a core term."
    }
  },
  "$defs": {
    "sha256String": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "assessment": { "enum": ["pass", "concern", "fail", "inconclusive", "not-applicable", "not-assessed"] },
    "taxonomyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "digest": { "$ref": "#/$defs/sha256String" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "manifestHash"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "manifestHash": { "$ref": "#/$defs/manifestHash" }
      }
    },
    "manifestHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "promptHash", "reviewInputsHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "promptHash": { "$ref": "#/$defs/sha256String" },
        "reviewInputsHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requestedModel", "effectiveModel", "thinkingLevel", "routePolicyVersion", "runId", "reviewRunId"],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "agent": { "type": "string", "minLength": 1, "maxLength": 200 },
        "provider": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "requestedModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "effectiveModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "thinkingLevel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "routePolicyVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "reviewRunId": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": {
          "enum": ["source-code", "test-result", "runtime-measurement", "tool-result", "artifact", "document", "human-attestation"]
        },
        "locator": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "symbolId": { "type": "string", "minLength": 1 }
          }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "contentHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "band"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "enum": ["A", "B", "C", "D", "F"] }
      }
    },
    "aspectObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectId", "assessment", "rationale"],
      "properties": {
        "aspectId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "assessment": { "$ref": "#/$defs/assessment" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "grade": { "$ref": "#/$defs/grade" }
      }
    },
    "findingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producerRef"],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "producerRef": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "observationFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationFindingId", "occurrenceFingerprint", "fingerprintAlgorithm",
        "ruleRef", "aspectId", "severity", "evidenceRefs", "source"
      ],
      "properties": {
        "observationFindingId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "issueId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "occurrenceFingerprint": { "$ref": "#/$defs/sha256String" },
        "fingerprintAlgorithm": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ruleRef": { "type": "string", "minLength": 1, "maxLength": 300 },
        "aspectId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "source": { "$ref": "#/$defs/findingSource" }
      }
    }
  }
}

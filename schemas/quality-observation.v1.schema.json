{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-observation.v1.schema.json",
  "title": "Quality Studio immutable observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "observationId", "taxonomy", "subject", "profile",
    "producer", "evidenceStatus", "evidence", "aspects", "assessment", "findings"
  ],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-observation.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "observationId": { "type": "string", "pattern": "^observation-sha256:[a-f0-9]{64}$" },
    "taxonomy": { "$ref": "#/$defs/taxonomyReference" },
    "subject": { "$ref": "#/$defs/subject" },
    "profile": { "$ref": "#/$defs/profile" },
    "producer": { "$ref": "#/$defs/producer" },
    "evidenceStatus": { "enum": ["available", "partial", "unavailable"] },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "aspects": {
      "type": "array",
      "items": { "$ref": "#/$defs/aspectObservation" }
    },
    "assessment": { "$ref": "#/$defs/assessment" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256String": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "assessment": { "enum": ["pass", "concern", "fail", "inconclusive", "not-applicable", "not-assessed"] },
    "producerKind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
    "taxonomyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "digest": { "$ref": "#/$defs/sha256String" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "manifestHash"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "manifestHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "promptHash", "reviewInputsHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 50 },
        "promptHash": { "$ref": "#/$defs/sha256String" },
        "reviewInputsHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runId"],
      "properties": {
        "kind": { "$ref": "#/$defs/producerKind" },
        "agent": { "type": "string", "minLength": 1, "maxLength": 200 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
        "requestedModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "effectiveModel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "thinkingLevel": { "type": "string", "minLength": 1, "maxLength": 50 },
        "routePolicyVersion": { "type": "string", "minLength": 1, "maxLength": 50 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "reviewRunId": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "evidenceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "symbolId": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": {
          "enum": [
            "source-code", "test-result", "runtime-measurement", "tool-result",
            "artifact", "document", "human-attestation"
          ]
        },
        "locator": { "$ref": "#/$defs/evidenceLocator" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "contentHash": { "$ref": "#/$defs/sha256String" }
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "band"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "enum": ["A", "B", "C", "D", "F"] }
      }
    },
    "aspectObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectId", "assessment", "rationale"],
      "properties": {
        "aspectId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "assessment": { "$ref": "#/$defs/assessment" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "grade": { "$ref": "#/$defs/grade" }
      }
    },
    "findingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producerRef"],
      "properties": {
        "kind": { "$ref": "#/$defs/producerKind" },
        "producerRef": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationFindingId", "issueId", "occurrenceFingerprint", "fingerprintAlgorithm",
        "ruleRef", "aspectId", "severity", "evidenceRefs", "source"
      ],
      "properties": {
        "observationFindingId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "issueId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "occurrenceFingerprint": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fingerprintAlgorithm": { "type": "string", "minLength": 1, "maxLength": 200 },
        "ruleRef": { "type": "string", "minLength": 1, "maxLength": 300 },
        "aspectId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "source": { "$ref": "#/$defs/findingSource" }
      }
    }
  }
}

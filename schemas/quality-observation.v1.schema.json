{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-observation.v1.schema.json",
  "title": "Quality Studio immutable observation v1",
  "type": "object",
  "patternProperties": { "^x-": true },
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "observationId", "taxonomy", "subject", "profile", "producer", "evidenceStatus", "evidence", "aspects", "assessment", "findings", "extensions"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-observation.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "observationId": { "$ref": "#/$defs/prefixedHash" },
    "taxonomy": { "$ref": "#/$defs/taxonomyRef" },
    "extensionTaxonomies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taxonomyRef" } },
    "subject": { "$ref": "#/$defs/subject" },
    "profile": { "$ref": "#/$defs/profile" },
    "producer": { "$ref": "#/$defs/producer" },
    "evidenceStatus": { "enum": ["available", "partial", "unavailable"] },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "aspects": { "type": "array", "items": { "$ref": "#/$defs/aspect" } },
    "assessment": { "$ref": "#/$defs/assessment" },
    "decision": { "$ref": "#/$defs/decision" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "prefixedHash": { "type": "string", "pattern": "^(?:observation-)?sha256:[a-f0-9]{64}$" },
    "extensions": { "type": "object", "additionalProperties": true },
    "extensible": {
      "type": "object",
      "properties": { "extensions": { "$ref": "#/$defs/extensions" } }
    },
    "taxonomyRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$" },
        "version": { "$ref": "#/$defs/semver" },
        "digest": { "$ref": "#/$defs/hash" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["unitId", "manifestHash"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1 },
        "manifestHash": { "$ref": "#/$defs/hash" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "promptHash", "reviewInputsHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "promptHash": { "$ref": "#/$defs/hash" },
        "reviewInputsHash": { "$ref": "#/$defs/hash" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "agent", "provider", "requestedModel", "effectiveModel", "thinkingLevel", "routePolicyVersion", "runId", "reviewRunId"],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "agent": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "requestedModel": { "type": "string", "minLength": 1 },
        "effectiveModel": { "type": "string", "minLength": 1 },
        "thinkingLevel": { "type": "string", "minLength": 1 },
        "routePolicyVersion": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "reviewRunId": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "symbolId": { "type": "string", "minLength": 1 },
        "artifactRef": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["source-code", "test-result", "runtime-measurement", "tool-result", "artifact", "document", "human-attestation"] },
        "locator": { "$ref": "#/$defs/locator" },
        "summary": { "type": "string", "minLength": 1 },
        "contentHash": { "$ref": "#/$defs/hash" },
        "mediaType": { "type": "string", "minLength": 1 },
        "raw": true,
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "anyOf": [ { "required": ["locator"] }, { "required": ["contentHash"] } ]
    },
    "grade": {
      "type": "object", "additionalProperties": false,
      "required": ["score", "band"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "enum": ["A", "B", "C", "D", "F"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "assessment": { "enum": ["pass", "concern", "fail", "inconclusive", "not-applicable", "not-assessed"] },
    "aspectId": { "type": "string", "pattern": "^(?:[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9.-]*|[a-z0-9.-]+:[a-z0-9][a-z0-9.-]*)$" },
    "aspect": {
      "type": "object", "additionalProperties": false,
      "required": ["aspectId", "assessment", "rationale"],
      "properties": {
        "aspectId": { "$ref": "#/$defs/aspectId" },
        "assessment": { "$ref": "#/$defs/assessment" },
        "rationale": { "type": "string", "minLength": 1 },
        "grade": { "$ref": "#/$defs/grade" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "producerRef"],
      "properties": {
        "kind": { "enum": ["agent", "deterministic-sensor", "human", "imported", "unknown"] },
        "producerRef": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["observationFindingId", "occurrenceFingerprint", "fingerprintAlgorithm", "ruleRef", "aspectId", "severity", "evidenceRefs", "source"],
      "properties": {
        "observationFindingId": { "type": "string", "minLength": 1 },
        "issueId": { "type": "string", "minLength": 1 },
        "occurrenceFingerprint": { "$ref": "#/$defs/hash" },
        "fingerprintAlgorithm": { "type": "string", "minLength": 1 },
        "ruleRef": { "type": "string", "minLength": 1 },
        "aspectId": { "$ref": "#/$defs/aspectId" },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "source": { "$ref": "#/$defs/source" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "policyRef"],
      "properties": {
        "value": { "enum": ["allow", "warn", "block", "defer"] },
        "policyRef": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    }
  }
}

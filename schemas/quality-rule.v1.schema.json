{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-rule.v1.schema.json",
  "title": "Quality Studio named rule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "id", "version", "name", "language", "category",
    "statement", "rationale", "badExample", "goodExample", "severity", "autofixable",
    "defaultOn", "appliesTo", "history"
  ],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-rule.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^QS-[A-Z]{2}-[0-9]{3}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "language": { "enum": ["angular", "dotnet"] },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "badExample": { "$ref": "#/$defs/example" },
    "goodExample": { "$ref": "#/$defs/example" },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "autofixable": { "type": "boolean" },
    "defaultOn": { "type": "boolean" },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewKinds", "fileExtensions"],
      "properties": {
        "reviewKinds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["code", "security", "performance"] }
        },
        "fileExtensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" }
        }
      }
    },
    "deterministicCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } }
    },
    "history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["date", "change"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "change": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  },
  "$defs": {
    "example": {
      "type": "object", "additionalProperties": false, "required": ["language", "code"],
      "properties": {
        "language": { "type": "string", "minLength": 1, "maxLength": 40 },
        "code": { "type": "string", "minLength": 1, "maxLength": 10000 }
      }
    }
  }
}

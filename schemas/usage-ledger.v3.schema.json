{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/usage-ledger.v3.schema.json",
  "title": "Quality Studio usage ledger entry v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId", "timestamp", "model", "cliType", "tokens", "kind", "level", "path",
    "schemaVersion", "provider", "requestedModel", "effectiveModel", "thinkingLevel",
    "routePolicyVersion"
  ],
  "properties": {
    "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "timestamp": { "type": "string", "format": "date-time" },
    "model": { "type": "string", "minLength": 1, "maxLength": 200 },
    "cliType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "tokens": { "$ref": "#/$defs/tokens" },
    "kind": { "enum": ["code", "security", "performance"] },
    "level": { "enum": ["project", "module", "namespace", "file", "function"] },
    "path": { "type": "string", "minLength": 1 },
    "reviewRunId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "schemaVersion": { "const": 3 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
    "requestedModel": { "type": "string", "minLength": 1, "maxLength": 200 },
    "effectiveModel": { "type": "string", "minLength": 1, "maxLength": 200 },
    "thinkingLevel": { "type": "string", "minLength": 1, "maxLength": 100 },
    "routePolicyVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
    "observationId": { "type": "string", "pattern": "^observation-sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cachedInputTokens", "reasoningOutputTokens", "durationMs"],
      "properties": {
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "cachedInputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoningOutputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/usage-ledger.v3.schema.json",
  "title": "Quality Studio usage ledger entry v3",
  "description": "One agent-backed review operation. Version 3 records model attribution and cost; sweep operations additionally join to their archived operation and immutable attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "timestamp", "model", "cliType", "tokens", "kind", "level", "path", "schemaVersion", "modelSource"],
  "oneOf": [
    { "required": ["reviewRunId", "operationId", "attempt"] },
    {
      "not": {
        "anyOf": [
          { "required": ["reviewRunId"] },
          { "required": ["operationId"] },
          { "required": ["attempt"] }
        ]
      }
    }
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Provider or CLI run identifier for this individual review operation."
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The model id the CLI was asked to run; runner-default is used only with the matching modelSource."
    },
    "cliType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "tokens": { "$ref": "#/$defs/tokens" },
    "kind": { "enum": ["code", "security", "performance"] },
    "level": { "enum": ["project", "module", "namespace", "file", "function"] },
    "path": { "type": "string", "minLength": 1 },
    "reviewRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Durable sweep/job identifier shared by every operation in one review run."
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Backend-allocated identity shared by this usage event and its archived operation."
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "description": "Stopped-attempt ordinal in the logical review run."
    },
    "schemaVersion": { "const": 3 },
    "modelSource": {
      "enum": ["explicit", "policy-default", "runner-default"],
      "description": "How Quality Studio selected or attributed the model."
    },
    "cost": { "$ref": "#/$defs/cost" }
  },
  "$defs": {
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "currency", "status"],
      "properties": {
        "total": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"], "minLength": 1, "maxLength": 10 },
        "status": { "type": "string", "minLength": 1, "maxLength": 50 }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cachedInputTokens", "reasoningOutputTokens", "durationMs"],
      "properties": {
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "cachedInputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoningOutputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

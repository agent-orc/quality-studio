{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio core taxonomy catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "taxonomy", "axes", "aspects"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerKind", "evidenceStatus", "assessment", "change",
        "decision", "severity", "lifecycle", "evidenceKind"
      ],
      "properties": {
        "producerKind": { "$ref": "#/$defs/axis" },
        "evidenceStatus": { "$ref": "#/$defs/axis" },
        "assessment": { "$ref": "#/$defs/axis" },
        "change": { "$ref": "#/$defs/axis" },
        "decision": { "$ref": "#/$defs/axis" },
        "severity": { "$ref": "#/$defs/axis" },
        "lifecycle": { "$ref": "#/$defs/axis" },
        "evidenceKind": { "$ref": "#/$defs/axis" }
      }
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aspect" }
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "terms"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/term" }
        }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" },
        "source": { "type": "string", "minLength": 1, "maxLength": 300 },
        "migrationAlias": { "type": "string", "minLength": 1, "maxLength": 100 },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}

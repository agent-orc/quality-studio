{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue",
  "description": "A term catalogue for the shared quality-observation vocabulary. Versioned independently by SemVer via the 'version' field; 'schemaVersion' only tracks this JSON structure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "catalogue", "version", "axes", "aspects"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "catalogue": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerKind", "evidenceStatus", "assessment", "change",
        "decision", "severity", "lifecycle", "evidenceKind"
      ],
      "properties": {
        "producerKind": { "$ref": "#/$defs/axis" },
        "evidenceStatus": { "$ref": "#/$defs/axis" },
        "assessment": { "$ref": "#/$defs/axis" },
        "change": { "$ref": "#/$defs/axis" },
        "decision": { "$ref": "#/$defs/axis" },
        "severity": { "$ref": "#/$defs/axis" },
        "lifecycle": { "$ref": "#/$defs/axis" },
        "evidenceKind": { "$ref": "#/$defs/axis" }
      }
    },
    "aspects": {
      "type": "array",
      "items": { "$ref": "#/$defs/aspect" }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms"],
      "properties": {
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/term" }
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "deprecated": { "type": "boolean" }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "deprecated": { "type": "boolean" }
      }
    }
  }
}

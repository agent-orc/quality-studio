{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio core taxonomy catalogue",
  "description": "Pins the term meanings shared by quality observations: producer kind, evidence status, assessment, change, decision, severity, lifecycle, evidence kind, and the initial core aspect catalogue. This is the quality-studio/core taxonomy, independently SemVer-versioned from the JSON envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "taxonomyId", "version", "axes", "aspects"],
  "properties": {
    "$schema": {
      "const": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "taxonomyId": {
      "const": "quality-studio/core"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerKind", "evidenceStatus", "assessment", "change",
        "decision", "severity", "lifecycle", "evidenceKind"
      ],
      "properties": {
        "producerKind": { "$ref": "#/$defs/termList" },
        "evidenceStatus": { "$ref": "#/$defs/termList" },
        "assessment": { "$ref": "#/$defs/termList" },
        "change": { "$ref": "#/$defs/termList" },
        "decision": { "$ref": "#/$defs/termList" },
        "severity": { "$ref": "#/$defs/termList" },
        "lifecycle": { "$ref": "#/$defs/termList" },
        "evidenceKind": { "$ref": "#/$defs/termList" }
      }
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aspectEntry" }
    }
  },
  "$defs": {
    "termList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/termEntry" }
    },
    "termEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "deprecated": {
          "type": "boolean"
        },
        "replacement": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "aspectEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "migrationAlias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "deprecated": {
          "type": "boolean"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "axes", "aspects"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*/[a-z][a-z0-9.-]*$" },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "minLength": 1 },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/axis" }
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aspect" }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "termId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "order", "aliases", "deprecated"],
      "properties": {
        "id": { "$ref": "#/$defs/termId" },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "$ref": "#/$defs/termId" }
      },
      "allOf": [
        {
          "if": { "properties": { "deprecated": { "const": true } }, "required": ["deprecated"] },
          "then": { "required": ["replacedBy"] },
          "else": { "not": { "required": ["replacedBy"] } }
        }
      ]
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "order", "terms"],
      "properties": {
        "id": { "$ref": "#/$defs/termId" },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/term" }
        }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "order", "aliases", "deprecated", "allowedAxes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$" },
        "allowedAxes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["assessment", "change"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "deprecated": { "const": true } }, "required": ["deprecated"] },
          "then": { "required": ["replacedBy"] },
          "else": { "not": { "required": ["replacedBy"] } }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "terms"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$" },
    "version": { "$ref": "#/$defs/semver" },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/term" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "axis", "description", "order", "aliases", "deprecated"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$" },
        "axis": {
          "enum": ["producer-kind", "evidence-status", "assessment", "change", "decision", "severity", "lifecycle", "evidence-kind", "aspect"]
        },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "deprecated": { "type": "boolean" },
        "replacement": { "type": "string", "minLength": 1 },
        "allowedAxes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["assessment", "change"] }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "deprecated": { "const": true } }, "required": ["deprecated"] },
          "then": { "required": ["replacement"] }
        },
        {
          "if": { "properties": { "axis": { "const": "aspect" } }, "required": ["axis"] },
          "then": { "required": ["allowedAxes"] },
          "else": { "not": { "required": ["allowedAxes"] } }
        }
      ]
    }
  }
}



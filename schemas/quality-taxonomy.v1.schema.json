{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "axes", "aspects"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*/)*[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "$ref": "#/$defs/semver" },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/axis" }
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aspect" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "termId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^(?:[a-z][a-z0-9.-]*|[a-z][a-z0-9.-]*:[a-z][a-z0-9.-]*)$" },
      "additionalProperties": true
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/termId" },
        "description": { "$ref": "#/$defs/description" },
        "order": { "type": "integer", "minimum": 0 },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "deprecated": { "type": "boolean" },
        "replacement": { "$ref": "#/$defs/termId" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [{
        "if": { "properties": { "deprecated": { "const": true } }, "required": ["deprecated"] },
        "then": { "required": ["replacement"] }
      }]
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "order", "terms"],
      "properties": {
        "id": { "$ref": "#/$defs/termId" },
        "description": { "$ref": "#/$defs/description" },
        "order": { "type": "integer", "minimum": 0 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/term" }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "order", "allowedAxes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/$defs/description" },
        "order": { "type": "integer", "minimum": 0 },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedAxes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/termId" }
        },
        "deprecated": { "type": "boolean" },
        "replacement": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [{
        "if": { "properties": { "deprecated": { "const": true } }, "required": ["deprecated"] },
        "then": { "required": ["replacement"] }
      }]
    }
  }
}

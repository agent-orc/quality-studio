{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "prefix", "axes", "aspects", "extensions"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "const": "quality-studio/core" },
    "version": { "const": "1.0.0" },
    "prefix": { "const": "quality-studio" },
    "axes": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/axis" }
    },
    "aspects": {
      "type": "array",
      "minItems": 16,
      "items": { "$ref": "#/$defs/aspect" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "terms", "extensions"],
      "properties": {
        "id": { "enum": ["producer-kind", "evidence-status", "assessment", "change", "decision", "severity", "lifecycle", "evidence-kind"] },
        "description": { "type": "string", "minLength": 1 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/term" }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "order", "aliases", "deprecated", "extensions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "deprecated": { "type": "boolean" },
        "replacement": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "aliases", "allowedAxes", "deprecated", "extensions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "allowedAxes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["assessment", "change"] },
          "uniqueItems": true
        },
        "deprecated": { "type": "boolean" },
        "replacement": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "prefix", "axes", "aspects"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^(?:[a-z0-9][a-z0-9.-]*/)?[a-z0-9][a-z0-9.-]*$" },
    "version": { "$ref": "#/$defs/semver" },
    "prefix": { "type": "string", "pattern": "^(?:[a-z0-9.-]+:)?$" },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producerKind", "evidenceStatus", "assessment", "change", "decision", "severity", "lifecycle", "evidenceKind"],
      "properties": {
        "producerKind": { "$ref": "#/$defs/terms" },
        "evidenceStatus": { "$ref": "#/$defs/terms" },
        "assessment": { "$ref": "#/$defs/terms" },
        "change": { "$ref": "#/$defs/terms" },
        "decision": { "$ref": "#/$defs/terms" },
        "severity": { "$ref": "#/$defs/terms" },
        "lifecycle": { "$ref": "#/$defs/terms" },
        "evidenceKind": { "$ref": "#/$defs/terms" }
      }
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aspect" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "termId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*(?::[a-z0-9][a-z0-9.-]*)?$" },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/term" }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/termId" },
        "order": { "type": "integer", "minimum": 0 },
        "description": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "$ref": "#/$defs/termId" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "order", "allowedAxes"],
      "properties": {
        "id": { "$ref": "#/$defs/termId" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "allowedAxes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["assessment", "change"] }
        },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "$ref": "#/$defs/termId" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}

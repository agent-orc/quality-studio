{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "axes", "aspects"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$" },
    "version": { "$ref": "#/$defs/semver" },
    "axes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/axis" } },
    "aspects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/aspect" } },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "extensions": { "type": "object", "additionalProperties": true },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "order", "aliases"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        { "if": { "properties": { "deprecated": { "const": true } }, "required": ["deprecated"] }, "then": { "required": ["replacedBy"] } }
      ]
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "order", "terms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "terms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/term" } },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "order", "aliases", "allowedAssessmentAxes"],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9.-]*|[a-z0-9.-]+:[a-z0-9][a-z0-9.-]*)$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "allowedAssessmentAxes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["assessment", "change"] } },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        { "if": { "properties": { "deprecated": { "const": true } }, "required": ["deprecated"] }, "then": { "required": ["replacedBy"] } }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "axes", "aspects"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/axis" }
    },
    "aspects": {
      "type": "array",
      "items": { "$ref": "#/$defs/aspect" }
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "terms"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/term" }
        }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "deprecated": { "type": "boolean" },
        "replacedBy": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}

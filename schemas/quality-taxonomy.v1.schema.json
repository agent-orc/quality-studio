{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "catalogueId", "catalogueVersion", "axes", "aspects"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "catalogueId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "catalogueVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/axis" }
    },
    "aspects": {
      "type": "array",
      "items": { "$ref": "#/$defs/aspect" }
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "deprecated": { "type": "boolean" }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "terms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/term" }
        }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "legacyAliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "axes", "aspects"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Reverse-DNS-style catalogue identity, for example quality-studio/core."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the term meanings. Major removes or changes meaning; minor adds a term or non-lossy alias; patch clarifies text only."
    },
    "axes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/axis" },
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" }
    },
    "aspects": {
      "type": "array",
      "items": { "$ref": "#/$defs/aspectDefinition" }
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "deprecated": { "type": "boolean" },
        "replacement": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms"],
      "properties": {
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/term" }
        }
      }
    },
    "aspectDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$",
          "description": "Namespaced core aspect id, for example code.correctness."
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "deprecated": { "type": "boolean" },
        "replacement": { "type": "string" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}

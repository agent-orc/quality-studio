{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-taxonomy.v1.schema.json",
  "title": "Quality Studio taxonomy catalogue",
  "description": "A versioned catalogue of taxonomy axes, terms, aliases, and aspects. Term meanings are governed by SemVer on the catalogue's own id/version, independent of this JSON structure's schemaVersion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "axes", "aspects"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/axis" }
    },
    "aspects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/aspect" }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "terms"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "rule": { "type": "string" },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/term" }
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "deprecated": { "type": "boolean" }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "currentSource": { "type": "string" },
        "migrationAlias": { "type": "string" }
      }
    }
  }
}

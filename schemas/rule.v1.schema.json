{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/rule.v1.schema.json",
  "title": "Quality Studio named rule v1",
  "description": "Normative shape of a rules/**/*.md document after YAML frontmatter parsing; 'content' is the Markdown body after the closing '---' delimiter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "technology",
    "category",
    "severity",
    "autofixable",
    "defaultOn",
    "kinds",
    "levels",
    "version",
    "status",
    "content"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^QS-[A-Z]{2,4}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "technology": {
      "enum": ["angular", "dotnet"]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "severity": {
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "autofixable": {
      "type": "boolean"
    },
    "defaultOn": {
      "type": "boolean"
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["code", "security", "performance"] }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["project", "module", "namespace", "file", "function"] }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["active", "deprecated"]
    },
    "deterministicCheck": {
      "$ref": "#/$defs/deterministicCheck"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  },
  "$defs": {
    "deterministicCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "ruleId"],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}

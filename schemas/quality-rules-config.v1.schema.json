{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-rules-config.v1.schema.json",
  "title": "Quality Studio project rule overrides",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "overrides"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-rules-config.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId"],
        "minProperties": 2,
        "properties": {
          "ruleId": { "type": "string", "pattern": "^QS-[A-Z]{2,8}-[0-9]{3}$" },
          "enabled": { "type": "boolean" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "autofixable": { "type": "boolean" },
          "parameters": { "type": "object" },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["angular", "csharp"] } },
              "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "exclude": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/quality-rules-config.v1.schema.json",
  "title": "Quality Studio project rule overrides v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "overrides"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/quality-rules-config.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "overrides": {
      "type": "object",
      "propertyNames": { "pattern": "^QS-[A-Z]{2,8}-[0-9]{3}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "enabled": { "type": "boolean" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] }
        }
      }
    }
  }
}

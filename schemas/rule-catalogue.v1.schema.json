{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/rule-catalogue.v1.schema.json",
  "title": "Quality Studio named-rule catalogue",
  "description": "Generated from rules/**/*.md by scripts/sync-rule-catalogue.mjs; embedded as the built-in rule library at src/AgentOrchestrator.CodeQuality/catalogues/rule-catalogue.v1.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "catalogueVersion", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "catalogueVersion": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "title", "technology", "category", "kinds", "statement", "rationale",
        "detection", "goodExample", "badExample", "severity", "defaultOn", "autofixable",
        "deterministicRuleIds", "relatedGuideline", "since", "changeHistory", "enabled"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^QS-[A-Z]{2,4}-[0-9]{3}$" },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "technology": { "enum": ["angular", "dotnet", "generic"] },
        "category": { "type": "string", "minLength": 1 },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["code", "security", "performance"] }
        },
        "statement": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "detection": { "type": "string", "minLength": 1 },
        "goodExample": { "type": "string", "minLength": 1 },
        "badExample": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "defaultOn": { "type": "boolean" },
        "autofixable": { "type": "boolean" },
        "deterministicRuleIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "relatedGuideline": { "type": ["string", "null"] },
        "since": { "type": "string", "minLength": 1 },
        "changeHistory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "date", "change"],
            "properties": {
              "version": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "format": "date" },
              "change": { "type": "string", "minLength": 1 }
            }
          }
        },
        "enabled": { "type": "boolean" }
      }
    }
  }
}

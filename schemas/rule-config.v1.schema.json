{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/rule-config.v1.schema.json",
  "title": "Quality Studio rule configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version"],
  "properties": {
    "$schema": {
      "const": "https://agent-orchestrator.dev/quality/schemas/rule-config.v1.schema.json"
    },
    "version": {
      "const": 1
    },
    "rules": {
      "$ref": "#/$defs/ruleMap"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "rules"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "not": { "pattern": "(^|/)\\.\\.(/|$)" }
            }
          },
          "rules": {
            "$ref": "#/$defs/ruleMap"
          }
        }
      }
    }
  },
  "$defs": {
    "ruleMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^QS-[A-Z]{2,8}-[0-9]{3}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/override"
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": {
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "options": {
          "type": "object",
          "minProperties": 1
        }
      }
    }
  }
}

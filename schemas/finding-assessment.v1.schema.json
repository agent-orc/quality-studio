{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/finding-assessment.v1.schema.json",
  "title": "Finding assessment event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "fingerprint", "status", "actor", "reason", "assessedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "enum": ["unassessed", "confirmed", "dismissed", "disputed"] },
    "actor": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "assessedAt": { "type": "string", "format": "date-time" },
    "reviewRunId": { "type": ["string", "null"] },
    "operationRunId": { "type": ["string", "null"] },
    "compatibilityProjection": { "type": "boolean" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json",
  "title": "Quality Studio run archive attempt record v1",
  "description": "Create-only snapshot of one stopped attempt, written to attempts/NNNN.json. A logical run may have more than one attempt; a later resume adds another attempt and never rewrites an earlier one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "runId", "attempt", "outcome", "completeness", "startedAt", "finishedAt",
    "totalFiles", "completedFiles", "failedFiles", "skippedFiles", "attemptUsage",
    "cumulativeUsage", "attemptCostSpent", "cumulativeCostSpent", "currency", "priceStatus",
    "errors", "stopReason", "tokenCap", "costCap", "estimateDeviation", "usageLedgerMonths",
    "qualitySummary"
  ],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["done", "failed", "cancelled", "capped"] },
    "completeness": { "enum": ["complete", "partial"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "totalFiles": { "type": "integer", "minimum": 0 },
    "completedFiles": { "type": "integer", "minimum": 0 },
    "failedFiles": { "type": "integer", "minimum": 0 },
    "skippedFiles": { "type": "integer", "minimum": 0 },
    "attemptUsage": { "$ref": "#/$defs/tokens" },
    "cumulativeUsage": { "$ref": "#/$defs/tokens" },
    "attemptCostSpent": { "$ref": "#/$defs/nullableNumber" },
    "cumulativeCostSpent": { "$ref": "#/$defs/nullableNumber" },
    "currency": { "$ref": "#/$defs/nullableString" },
    "priceStatus": { "type": "string", "minLength": 1 },
    "errors": { "type": "array", "items": { "type": "string", "maxLength": 4000 } },
    "stopReason": { "$ref": "#/$defs/nullableString" },
    "tokenCap": { "$ref": "#/$defs/nullableInteger" },
    "costCap": { "$ref": "#/$defs/nullableNumber" },
    "estimateDeviation": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/estimateDeviation" }] },
    "usageLedgerMonths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }
    },
    "qualitySummary": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/qualitySummary" }] }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cachedInputTokens", "reasoningOutputTokens", "durationMs"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/nullableInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableInteger" },
        "cachedInputTokens": { "$ref": "#/$defs/nullableInteger" },
        "reasoningOutputTokens": { "$ref": "#/$defs/nullableInteger" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "estimateDeviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokensPercent", "outputTokensPercent", "costPercent", "note"],
      "properties": {
        "inputTokensPercent": { "type": "number" },
        "outputTokensPercent": { "type": "number" },
        "costPercent": { "$ref": "#/$defs/nullableNumber" },
        "note": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lowestGradeScore", "lowestGradeBand", "worstSecurityVerdict", "activeFindingCount", "highestActiveSeverity"],
      "properties": {
        "lowestGradeScore": { "$ref": "#/$defs/nullableInteger" },
        "lowestGradeBand": { "type": ["string", "null"], "enum": ["A", "B", "C", "D", "F", null] },
        "worstSecurityVerdict": { "type": ["string", "null"], "enum": ["pass", "warn", "block", "unavailable", null] },
        "activeFindingCount": { "$ref": "#/$defs/nullableInteger" },
        "highestActiveSeverity": { "type": ["string", "null"], "enum": ["critical", "high", "medium", "low", "info", null] }
      }
    }
  }
}

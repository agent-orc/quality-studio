{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json",
  "title": "Quality Studio archived review run attempt record v1",
  "description": "Create-only snapshot of one stopped attempt of a review run, written to .quality/run-history/YYYY-MM/<runId>/attempts/NNNN.json. A capped run that resumes adds another attempt; earlier attempts are never rewritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "runId", "attempt", "outcome", "completeness",
    "startedAt", "finishedAt", "totalFiles", "completedFiles", "failedFiles", "skippedFiles",
    "usage", "priceStatus", "archivedAt"
  ],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "attempt": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["done", "failed", "cancelled", "capped"] },
    "completeness": { "enum": ["complete", "partial"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },
    "totalFiles": { "type": "integer", "minimum": 0 },
    "completedFiles": { "type": "integer", "minimum": 0 },
    "failedFiles": { "type": "integer", "minimum": 0 },
    "skippedFiles": { "type": "integer", "minimum": 0 },
    "usage": { "$ref": "#/$defs/tokens" },
    "costSpent": { "type": ["number", "null"], "minimum": 0 },
    "currency": { "type": ["string", "null"], "minLength": 1, "maxLength": 10 },
    "priceStatus": { "type": "string", "minLength": 1, "maxLength": 100 },
    "stopReason": { "type": ["string", "null"], "minLength": 1, "maxLength": 4000 },
    "usageLedgerMonths": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" } },
    "archivedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cachedInputTokens", "reasoningOutputTokens", "durationMs"],
      "properties": {
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "cachedInputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoningOutputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

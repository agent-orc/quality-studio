{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json",
  "title": "Quality Studio archived run attempt record v1",
  "description": "One create-only attempts/NNNN.json snapshot per stopped attempt of a logical run. A capped run that later resumes adds another attempt; it never rewrites an earlier one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "attempt", "outcome", "completeness", "startedAt", "finishedAt", "counters", "cumulativeCounters", "usage", "cost", "currency", "priceStatus", "errorCodes", "cap", "estimateDeviation", "usageLedgerMonths", "qualitySummary", "archivedAt"],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["done", "failed", "cancelled", "capped"] },
    "completeness": { "enum": ["complete", "partial"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },
    "counters": { "$ref": "#/$defs/counters" },
    "cumulativeCounters": { "$ref": "#/$defs/counters" },
    "usage": { "$ref": "#/$defs/tokens" },
    "cost": { "$ref": "#/$defs/nullableNumber" },
    "currency": { "$ref": "#/$defs/nullableString" },
    "priceStatus": { "type": "string", "minLength": 1 },
    "errorCodes": { "type": "array", "items": { "type": "string", "maxLength": 4000 } },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenLimit", "costLimit", "outcome", "reason"],
      "properties": {
        "tokenLimit": { "$ref": "#/$defs/nullableInteger" },
        "costLimit": { "$ref": "#/$defs/nullableNumber" },
        "outcome": { "enum": ["not-configured", "within-cap", "reached"] },
        "reason": { "$ref": "#/$defs/nullableString" }
      }
    },
    "estimateDeviation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokensPercent", "outputTokensPercent", "costPercent"],
          "properties": {
            "inputTokensPercent": { "$ref": "#/$defs/nullableNumber" },
            "outputTokensPercent": { "$ref": "#/$defs/nullableNumber" },
            "costPercent": { "$ref": "#/$defs/nullableNumber" }
          }
        }
      ]
    },
    "usageLedgerMonths": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" } },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lowestGrade", "worstSecurityVerdict", "activeFindingCount", "highestActiveSeverity"],
      "properties": {
        "lowestGrade": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["score", "band"],
              "properties": {
                "score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "band": { "enum": ["A", "B", "C", "D", "F"] }
              }
            }
          ]
        },
        "worstSecurityVerdict": {
          "oneOf": [{ "type": "null" }, { "enum": ["pass", "warn", "block", "unavailable"] }]
        },
        "activeFindingCount": { "type": "integer", "minimum": 0 },
        "highestActiveSeverity": {
          "oneOf": [{ "type": "null" }, { "enum": ["critical", "high", "medium", "low", "info"] }]
        }
      }
    },
    "archivedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalFiles", "completedFiles", "failedFiles", "skippedFiles"],
      "properties": {
        "totalFiles": { "type": "integer", "minimum": 0 },
        "completedFiles": { "type": "integer", "minimum": 0 },
        "failedFiles": { "type": "integer", "minimum": 0 },
        "skippedFiles": { "type": "integer", "minimum": 0 }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cachedInputTokens", "reasoningOutputTokens", "durationMs"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/nullableInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableInteger" },
        "cachedInputTokens": { "$ref": "#/$defs/nullableInteger" },
        "reasoningOutputTokens": { "$ref": "#/$defs/nullableInteger" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json",
  "title": "Quality Studio archived run attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runId", "attempt", "outcome", "completeness", "startedAt", "finishedAt", "counters", "usage", "errors", "stopReason", "ledgerMonths", "summary"],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["done", "failed", "cancelled", "capped"] },
    "completeness": { "enum": ["complete", "partial"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "counters": { "$ref": "#/$defs/counters" },
    "usage": { "$ref": "#/$defs/usage" },
    "errors": { "type": "array", "items": { "type": "string", "maxLength": 4000 } },
    "stopReason": { "$ref": "#/$defs/nullableString" },
    "ledgerMonths": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" } },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalFiles", "completedFiles", "failedFiles", "skippedFiles"],
      "properties": {
        "totalFiles": { "type": "integer", "minimum": 0 },
        "completedFiles": { "type": "integer", "minimum": 0 },
        "failedFiles": { "type": "integer", "minimum": 0 },
        "skippedFiles": { "type": "integer", "minimum": 0 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "inputTokens", "outputTokens", "cachedInputTokens", "reasoningOutputTokens", "durationMs", "cost", "currency", "priceStatus"],
      "properties": {
        "operations": { "type": "integer", "minimum": 0 },
        "inputTokens": { "$ref": "#/$defs/nullableInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableInteger" },
        "cachedInputTokens": { "$ref": "#/$defs/nullableInteger" },
        "reasoningOutputTokens": { "$ref": "#/$defs/nullableInteger" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "cost": { "$ref": "#/$defs/nullableNumber" },
        "currency": { "$ref": "#/$defs/nullableString" },
        "priceStatus": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lowestGrade", "worstSecurityVerdict", "activeFindingCount", "highestActiveSeverity"],
      "properties": {
        "lowestGrade": { "type": ["string", "null"], "enum": ["A", "B", "C", "D", "F", null] },
        "worstSecurityVerdict": { "type": ["string", "null"], "enum": ["pass", "warn", "block", "unavailable", null] },
        "activeFindingCount": { "type": "integer", "minimum": 0 },
        "highestActiveSeverity": { "type": ["string", "null"], "enum": ["critical", "high", "medium", "low", "info", null] }
      }
    }
  }
}

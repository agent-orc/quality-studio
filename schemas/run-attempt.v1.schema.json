{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json",
  "title": "Quality Studio archived stopped attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runId", "attempt", "outcome", "complete", "startedAt", "finishedAt", "totalFiles", "completedFiles", "failedFiles", "skippedFiles", "errors", "usageOperations", "usage", "priceStatus", "ledgerMonths", "operationIds", "quality", "archivedAt", "provenance"],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["done", "failed", "cancelled", "capped"] },
    "complete": { "type": "boolean" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "totalFiles": { "type": "integer", "minimum": 0 },
    "completedFiles": { "type": "integer", "minimum": 0 },
    "failedFiles": { "type": "integer", "minimum": 0 },
    "skippedFiles": { "type": "integer", "minimum": 0 },
    "aggregateState": { "type": ["string", "null"] },
    "errors": { "type": "array", "items": { "type": "string" } },
    "stopReason": { "type": ["string", "null"] },
    "tokenCap": { "type": ["integer", "null"], "minimum": 1 },
    "costCap": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "usageOperations": { "type": "integer", "minimum": 0 },
    "usage": { "type": "object" },
    "costSpent": { "type": ["number", "null"], "minimum": 0 },
    "currency": { "type": ["string", "null"] },
    "priceStatus": { "type": "string", "minLength": 1 },
    "ledgerMonths": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" } },
    "operationIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "quality": { "type": "object" },
    "archivedAt": { "type": "string", "format": "date-time" },
    "provenance": { "enum": ["native", "migrated-from-run-store-v0"] }
  }
}

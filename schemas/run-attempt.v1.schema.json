{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json",
  "title": "Quality Studio run archive attempt record v1",
  "description": "One create-only snapshot per stopped attempt of a review run, written to .quality/run-history/YYYY-MM/<runId>/attempts/NNNN.json. A capped run that resumes adds another attempt file; earlier attempts are never rewritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "runId",
    "attempt",
    "outcome",
    "completeness",
    "counters",
    "cumulativeCounters",
    "spend",
    "priceStatus",
    "errorCodes",
    "ledgerReferences",
    "archivedAt"
  ],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "attempt": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["done", "failed", "cancelled", "capped"] },
    "completeness": { "enum": ["complete", "partial"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },
    "counters": { "$ref": "#/$defs/counters" },
    "cumulativeCounters": { "$ref": "#/$defs/counters" },
    "spend": { "$ref": "#/$defs/spend" },
    "cost": { "type": ["number", "null"], "minimum": 0 },
    "currency": { "type": ["string", "null"], "minLength": 1, "maxLength": 10 },
    "priceStatus": { "type": "string", "minLength": 1 },
    "errorCodes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tokenCap": { "type": ["integer", "null"], "minimum": 0 },
    "costCap": { "type": ["number", "null"], "minimum": 0 },
    "estimateDeviationPercent": { "type": ["number", "null"] },
    "ledgerReferences": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" } },
    "qualitySummary": { "type": ["object", "null"], "$ref": "#/$defs/qualitySummary" },
    "archivedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed", "failed", "skipped", "cancelled"],
      "properties": {
        "reviewed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "integer", "minimum": 0 }
      }
    },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cachedInputTokens", "reasoningOutputTokens", "durationMs"],
      "properties": {
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "cachedInputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoningOutputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeFindings"],
      "properties": {
        "lowestGradeScore": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "lowestGradeBand": { "type": ["string", "null"], "minLength": 1, "maxLength": 4 },
        "worstSecurityVerdict": { "enum": ["pass", "warn", "block", "unavailable", null] },
        "activeFindings": { "type": "integer", "minimum": 0 },
        "highestActiveSeverity": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}

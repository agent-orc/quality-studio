{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json",
  "title": "Quality Studio run-history attempt record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runId", "attemptNumber", "outcome", "completeness", "createdAt", "archivedAt", "counters", "usage"],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "attemptNumber": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["done", "failed", "cancelled", "capped"] },
    "completeness": { "enum": ["complete", "partial"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "archivedAt": { "type": "string", "format": "date-time" },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalFiles", "completedFiles", "failedFiles", "skippedFiles"],
      "properties": {
        "totalFiles": { "type": "integer", "minimum": 0 },
        "completedFiles": { "type": "integer", "minimum": 0 },
        "failedFiles": { "type": "integer", "minimum": 0 },
        "skippedFiles": { "type": "integer", "minimum": 0 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cachedInputTokens", "reasoningOutputTokens", "durationMs"],
      "properties": {
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "cachedInputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoningOutputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "costSpent": { "type": ["number", "null"], "minimum": 0 },
    "currency": { "type": ["string", "null"], "minLength": 1, "maxLength": 20 },
    "priceStatus": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
    "stopReason": { "type": ["string", "null"] },
    "errorCodes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "estimateDeviation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["inputTokensPercent", "outputTokensPercent"],
      "properties": {
        "inputTokensPercent": { "type": "number" },
        "outputTokensPercent": { "type": "number" },
        "costPercent": { "type": ["number", "null"] }
      }
    },
    "ledgerMonths": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" } },
    "operationIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "qualitySummary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["activeFindingCount"],
      "properties": {
        "lowestGrade": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["score", "band"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "band": { "type": "string", "minLength": 1, "maxLength": 10 }
          }
        },
        "worstSecurityVerdict": { "type": ["string", "null"], "enum": ["pass", "warn", "block", "unavailable", null] },
        "activeFindingCount": { "type": "integer", "minimum": 0 },
        "highestActiveSeverity": { "type": ["string", "null"] }
      }
    }
  }
}

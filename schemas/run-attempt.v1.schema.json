{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json",
  "title": "Quality Studio run archive attempt record v1",
  "description": "Create-only snapshot of one stopped attempt of a review run, written to attempts/NNNN.json. A capped run that resumes adds another attempt; an earlier attempt is never rewritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "runId",
    "attemptNumber",
    "outcome",
    "completeness",
    "finishedAt",
    "counters",
    "cumulativeCounters",
    "spend",
    "cumulativeSpend",
    "errorCodes",
    "cap",
    "ledgerReferences",
    "qualitySummary"
  ],
  "properties": {
    "$schema": {
      "const": "https://agent-orchestrator.dev/quality/schemas/run-attempt.v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "attemptNumber": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["done", "failed", "cancelled", "capped"] },
    "completeness": { "enum": ["complete", "partial"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
    "finishedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "counters": { "$ref": "#/$defs/counters" },
    "cumulativeCounters": { "$ref": "#/$defs/counters" },
    "spend": { "$ref": "#/$defs/spend" },
    "cumulativeSpend": { "$ref": "#/$defs/spend" },
    "errorCodes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "cap": { "$ref": "#/$defs/cap" },
    "estimateDeviation": { "$ref": "#/$defs/estimateDeviation" },
    "ledgerReferences": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }
    },
    "qualitySummary": { "$ref": "#/$defs/qualitySummary" },
    "stopReason": { "type": ["string", "null"], "minLength": 1, "maxLength": 4000 }
  },
  "$defs": {
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalFiles", "completedFiles", "failedFiles", "skippedFiles"],
      "properties": {
        "totalFiles": { "type": "integer", "minimum": 0 },
        "completedFiles": { "type": "integer", "minimum": 0 },
        "failedFiles": { "type": "integer", "minimum": 0 },
        "skippedFiles": { "type": "integer", "minimum": 0 }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cachedInputTokens", "reasoningOutputTokens", "durationMs"],
      "properties": {
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "cachedInputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoningOutputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usage", "priceStatus"],
      "properties": {
        "usage": { "$ref": "#/$defs/tokens" },
        "costSpent": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"], "minLength": 1, "maxLength": 10 },
        "priceStatus": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenCap": { "type": ["integer", "null"], "minimum": 1 },
        "costCap": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "estimateDeviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokensPercent", "outputTokensPercent", "note"],
      "properties": {
        "inputTokensPercent": { "type": "number" },
        "outputTokensPercent": { "type": "number" },
        "costPercent": { "type": ["number", "null"] },
        "note": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeFindingCount"],
      "properties": {
        "lowestGrade": { "$ref": "#/$defs/gradeOrNull" },
        "worstSecurityVerdict": { "enum": ["pass", "warn", "block", "unavailable", null] },
        "activeFindingCount": { "type": "integer", "minimum": 0 },
        "highestActiveSeverity": { "enum": ["critical", "high", "medium", "low", "info", null] }
      }
    },
    "gradeOrNull": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "band"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "band": { "enum": ["A", "B", "C", "D", "F"] }
          }
        }
      ]
    }
  }
}

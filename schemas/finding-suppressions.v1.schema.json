{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/finding-suppressions.v1.schema.json",
  "title": "Finding suppression policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "match", "effect", "reason", "author", "createdAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,200}$" },
          "enabled": { "type": "boolean" },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "fingerprint": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
              "ruleId": { "type": ["string", "null"] },
              "pathPattern": { "type": ["string", "null"] },
              "reviewKinds": { "type": "array", "uniqueItems": true, "items": { "enum": ["code", "security", "performance"] } },
              "sourceKinds": { "type": "array", "uniqueItems": true, "items": { "enum": ["agent", "deterministic"] } }
            }
          },
          "effect": { "const": "suppress" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "author": { "type": "string", "minLength": 1, "maxLength": 200 },
          "createdAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}


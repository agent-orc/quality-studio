{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-operation.v1.schema.json",
  "title": "Quality Studio run archive operation record v1",
  "description": "One append-only line in operations.jsonl for a completed or failed review operation, written only after the sidecar result is persisted or a terminal operation error is known.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "operationId", "runId", "attempt", "ordinal", "unitId", "path", "level",
    "state", "startedAt", "finishedAt", "providerRunId", "subjectHash", "reviewedHash",
    "sidecarPath", "grade", "securityVerdict", "error"
  ],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-operation.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "ordinal": { "type": "integer", "minimum": 1 },
    "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "path": { "$ref": "#/$defs/repoPath" },
    "level": { "enum": ["project", "module", "namespace", "file"] },
    "state": { "enum": ["done", "failed", "cancelled", "skipped", "skipped-fresh"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },
    "providerRunId": { "$ref": "#/$defs/nullableString" },
    "subjectHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "reviewedHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "sidecarPath": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/repoPath" }] },
    "grade": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/grade" }] },
    "securityVerdict": { "type": ["string", "null"], "enum": ["pass", "warn", "block", "unavailable", null] },
    "error": { "$ref": "#/$defs/nullableString" }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)[^\\\\]+)$"
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "band", "rationale"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "enum": ["A", "B", "C", "D", "F"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator.dev/quality/schemas/run-operation.v1.schema.json",
  "title": "Quality Studio archived run operation record v1",
  "description": "One append-only line in operations.jsonl, written after a review operation's sidecar result is persisted or its terminal error is known.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "operationId", "ordinal", "attempt", "unitId", "path", "level", "state", "startedAt", "finishedAt", "providerRunId", "reviewedHash", "sidecarPath", "sidecarSha256", "verdict"],
  "properties": {
    "$schema": { "const": "https://agent-orchestrator.dev/quality/schemas/run-operation.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "ordinal": { "type": "integer", "minimum": 0 },
    "attempt": { "type": "integer", "minimum": 1 },
    "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "path": { "$ref": "#/$defs/repoPath" },
    "level": { "enum": ["project", "module", "namespace", "file"] },
    "state": { "enum": ["done", "failed", "cancelled", "skipped", "skipped-fresh"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },
    "providerRunId": { "$ref": "#/$defs/nullableString" },
    "reviewedHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "sidecarPath": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/repoPath" }] },
    "sidecarSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "grade", "securityVerdict"],
      "properties": {
        "kind": { "enum": ["grade", "security", "unavailable"] },
        "grade": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["score", "band"],
              "properties": {
                "score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "band": { "enum": ["A", "B", "C", "D", "F"] }
              }
            }
          ]
        },
        "securityVerdict": {
          "oneOf": [{ "type": "null" }, { "enum": ["pass", "warn", "block", "unavailable"] }]
        }
      }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)[^\\\\]+)$"
    }
  }
}

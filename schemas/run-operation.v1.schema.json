{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.studio/schemas/run-operation.v1.schema.json",
  "title": "Quality Studio archived review operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runId", "operationId", "ordinal", "attempt", "unitId", "path", "level", "state", "startedAt", "finishedAt", "providerRunId", "reviewedHash", "inputHash", "resultSidecar", "verdict", "grade"],
  "properties": {
    "$schema": { "const": "https://quality.studio/schemas/run-operation.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/id" },
    "operationId": { "$ref": "#/$defs/id" },
    "ordinal": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "unitId": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "path": { "$ref": "#/$defs/repoPath" },
    "level": { "enum": ["project", "module", "namespace", "file"] },
    "state": { "enum": ["done", "failed", "cancelled", "skipped", "skipped-fresh"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "providerRunId": { "$ref": "#/$defs/nullableString" },
    "reviewedHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "inputHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "resultSidecar": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/repoPath" }] },
    "verdict": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "type": "string", "minLength": 1, "maxLength": 100 },
            "value": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        }
      ]
    },
    "grade": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["score", "band", "rationale"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "band": { "enum": ["A", "B", "C", "D", "F"] },
            "rationale": { "$ref": "#/$defs/nullableString" }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableString": { "type": ["string", "null"] },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+)$" }
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "QualityStudio": {
    "RepositoryRoot": "../../..",
    "AllowedRoots": [
      "../../.."
    ],
    "DataRoot": null,
    "GlobalInputsDirectory": null,
    "InputBudgetCharacters": 12000,
    "DefaultReviewTokenCap": 100000,
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "AnalyzerProfiles": {
      "Path": null,
      "AllowInlineCommands": false
    },
    "Limits": {
      "MaxFileBytes": 2097152,
      "LargeFilePreviewBytes": 65536,
      "SensorAvailabilityCacheSeconds": 300,
      "ProjectDashboardCacheEntries": 32
    },
    "Security": {
      "Mode": "Local",
      "AllowNonLoopbackLocalMode": false,
      "RequireHttps": true,
      "MaxRequestBodyBytes": 65536,
      "MaxConcurrentRequests": 32,
      "SpendRequestsPerMinute": 5,
      "Clients": []
    }
  },
  "AgentStudio": {
    "BaseUrl": null,
    "ClientId": null,
    "Project": null,
    "DryRun": true
  },
  "ReviewJobs": {
    "MaxConcurrency": 2,
    "RecentRunLimit": 30
  }
}

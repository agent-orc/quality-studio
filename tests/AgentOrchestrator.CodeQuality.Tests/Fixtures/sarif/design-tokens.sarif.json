{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "qs-design-tokens-check",
          "informationUri": "https://quality.studio/schemas/rule.v1.schema.json",
          "semanticVersion": "1.0.0",
          "rules": [
            { "id": "QS-NG-003", "name": "DesignTokensOverRawLiterals" },
            { "id": "QS-NG-004", "name": "ExtendTokenScaleInsteadOfDuplicating" }
          ]
        }
      },
      "results": [
        {
          "ruleId": "QS-NG-003",
          "level": "warning",
          "message": {
            "text": "Raw literal '#3c7ba6' outside :root; use an existing --studio-*/--font-* design token instead."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "frontend/src/app/app.css" },
                "region": { "startLine": 5, "startColumn": 92, "endLine": 5, "endColumn": 99 }
              }
            }
          ]
        },
        {
          "ruleId": "QS-NG-004",
          "level": "note",
          "message": {
            "text": "Raw literal '24px' repeated across 3 stylesheets (frontend/src/app/explorer/explorer.css, frontend/src/app/project-dashboard/project-dashboard.css, frontend/src/app/review-panel/review-panel.css); extend the token scale in frontend/src/styles.css instead of copying the value."
          },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "frontend/src/app/explorer/explorer.css" } } },
            { "physicalLocation": { "artifactLocation": { "uri": "frontend/src/app/project-dashboard/project-dashboard.css" } } },
            { "physicalLocation": { "artifactLocation": { "uri": "frontend/src/app/review-panel/review-panel.css" } } }
          ]
        }
      ]
    }
  ]
}
